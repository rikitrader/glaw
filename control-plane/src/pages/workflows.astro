---
import ControlPlaneLayout from "../layouts/ControlPlaneLayout.astro";
const workflows = [["matter-intake-spine", "Matter Intake Spine", "confirmed", "8 steps", "Matter Management"], ["litigation-analysis", "Litigation Analysis", "proposed", "12 steps", "Litigation"], ["red-blue-review", "Red / Blue Review", "proposed", "6 steps", "Governance"]];
---
<ControlPlaneLayout title="Workflows" eyebrow="OPERATIONS / 02" active="workflows" description="GLAW workflow registry and execution control">
  <section class="page-intro"><div><p class="eyebrow">WORKFLOW CONTROL</p><h1>Make the work <em>inspectable.</em></h1></div><div><p class="page-intro-copy">Definitions are versioned independently from canvas layout. Every execution must carry its workflow, policy, model, source, and approval lineage.</p><div class="page-actions"><a class="secondary-action" href="/architecture">Graph view</a><a class="primary-action" href="/workflows/new">＋ New workflow</a></div></div></section>
  <section class="content-grid"><article class="panel"><div class="panel-head"><div><p class="eyebrow">WORKFLOW REGISTRY</p><h2>Definitions</h2></div><span class="mono">3 visible / 7 registered</span></div><table class="table"><thead><tr><th>Workflow</th><th>Status</th><th>Steps</th><th>Owner</th></tr></thead><tbody>{workflows.map(([id, name, status, steps, owner]) => <tr><td><a href={`/workflows/${id}`}><strong>{name}</strong><small class="mono">{id} · v1.0.0</small></a></td><td><span class:list={["pill", status === "confirmed" ? "good" : "info"]}>{status}</span></td><td class="mono">{steps}</td><td>{owner}</td></tr>)}</tbody></table></article><article class="panel"><div class="panel-head"><div><p class="eyebrow">VALIDATION</p><h2>Workflow Doctor</h2></div><a href="/architecture">Details →</a></div><ul class="list"><li><div><strong>Every edge resolves</strong><small>Canonical graph invariant</small></div><span class="pill good">Pass</span></li><li><div><strong>Approval path exists</strong><small>High-risk output rule</small></div><span class="pill warn">Review</span></li><li><div><strong>Execution adapter</strong><small>Cloudflare Workflows</small></div><span class="pill info">Proposed</span></li></ul></article></section>
</ControlPlaneLayout>
