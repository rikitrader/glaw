---
import ControlPlaneLayout from "../layouts/ControlPlaneLayout.astro";
const policies = [["no-unsourced-authority", "No unsourced legal authority", "Critical", "Citation validator"], ["no-cross-matter", "No cross-matter data leakage", "Critical", "Retrieval policy"], ["human-review", "High-risk release requires human review", "High", "Approval engine"], ["red-blue-required", "Red Team findings cannot be hidden", "High", "Review loop"]];
---
<ControlPlaneLayout title="Governance" eyebrow="GOVERNANCE / 00" active="governance" description="GLAW legal AI governance, approvals, and policy">
  <section class="page-intro"><div><p class="eyebrow">GOVERNANCE CONTROL</p><h1>Make risk <em>visible.</em></h1></div><div><p class="page-intro-copy">Policies govern retrieval, tools, model selection, review rounds, approvals, release, and audit. A warning is a workflow state, not a decoration.</p><div class="page-actions"><a class="secondary-action" href="/agents">Agent registry</a><a class="primary-action" href="/governance/policies">Manage policies →</a></div></div></section>
  <section class="content-grid"><article class="panel"><div class="panel-head"><div><p class="eyebrow">POLICY REGISTRY</p><h2>Release safeguards</h2></div><span class="pill good">4 active</span></div><table class="table"><thead><tr><th>Policy</th><th>Severity</th><th>Enforced by</th></tr></thead><tbody>{policies.map(([id, name, severity, owner]) => <tr><td><strong>{name}</strong><small class="mono">{id}</small></td><td><span class:list={["pill", severity === "Critical" ? "bad" : "warn"]}>{severity}</span></td><td>{owner}</td></tr>)}</tbody></table></article><article class="panel"><div class="panel-head"><div><p class="eyebrow">REVIEW LOOP</p><h2>RED → BLUE → Human</h2></div></div><ul class="list"><li><div><strong>Red Team</strong><small>Attack argument, evidence, procedure, citation</small></div><span class="pill info">Required</span></li><li><div><strong>Blue Team</strong><small>Remediate findings and revise output</small></div><span class="pill info">Required</span></li><li><div><strong>Attorney approval</strong><small>Release authority for high-risk output</small></div><span class="pill warn">Pending</span></li></ul></article></section>
  <section class="panel"><div class="panel-head"><div><p class="eyebrow">TRAFFIC LIGHT</p><h2>Release states</h2></div></div><div class="release-grid"><div class="release green"><strong>GREEN</strong><span>Validated for configured use</span></div><div class="release yellow"><strong>YELLOW</strong><span>Requires attorney review</span></div><div class="release red"><strong>RED</strong><span>Do not release or rely upon</span></div></div></section>
</ControlPlaneLayout>

<style>.release-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 18px; }.release { padding: 18px; border: 1px solid currentColor; border-radius: 4px; }.release strong, .release span { display: block; }.release strong { font: 12px monospace; }.release span { color: #9aa8af; font-size: 12px; margin-top: 8px; }.release.green { color: #57c1b5; }.release.yellow { color: #e3a84b; }.release.red { color: #e36b68; } @media (max-width: 650px) { .release-grid { grid-template-columns: 1fr; } }</style>
