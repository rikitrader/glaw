---
import ControlPlaneLayout from "../layouts/ControlPlaneLayout.astro";
const agents = [["managing-partner", "Managing Partner", "Firm Management", "Orchestrator", "Confirmed", "13 skills"], ["legal-research", "Legal Research Agent", "Legal Research", "Specialist", "Confirmed", "8 skills"], ["adverse-authority", "Adverse Authority Agent", "Governance", "Reviewer", "Proposed", "4 skills"], ["citation-validator", "Citation Validator", "Governance", "Validator", "Proposed", "5 skills"]];
---
<ControlPlaneLayout title="Agents" eyebrow="AI / 00" active="agents" description="GLAW agent registry and governance">
  <section class="page-intro"><div><p class="eyebrow">AGENT REGISTRY</p><h1>Controlled intelligence, <em>visible.</em></h1></div><div><p class="page-intro-copy">Agents operate through bounded skills, tools, sources, models, validators, and human review policies. No agent is autonomous by default.</p><div class="page-actions"><a class="secondary-action" href="/knowledge">Knowledge policy</a><a class="primary-action" href="/agents/new">＋ Add agent</a></div></div></section>
  <section class="metrics"><article class="metric"><p class="metric-label">Registered agents</p><strong class="metric-value">19</strong><span class="metric-note good">Registry loaded</span></article><article class="metric"><p class="metric-label">Confirmed</p><strong class="metric-value">12</strong><span class="metric-note good">Existing seats</span></article><article class="metric"><p class="metric-label">Proposed</p><strong class="metric-value">07</strong><span class="metric-note info">Governance layer</span></article><article class="metric"><p class="metric-label">Unbounded access</p><strong class="metric-value">00</strong><span class="metric-note good">Validator target</span></article></section>
  <section class="panel table-panel"><div class="panel-head"><div><p class="eyebrow">GOVERNED AGENT TEAM</p><h2>Agent registry</h2></div><a href="/governance">Review policies →</a></div><table class="table"><thead><tr><th>Agent</th><th>Department</th><th>Role</th><th>Status</th><th>Surface</th></tr></thead><tbody>{agents.map(([id, name, department, role, status, surface]) => <tr><td><a href={`/agents/${id}`}><strong>{name}</strong><small class="mono">{id}</small></a></td><td>{department}</td><td>{role}</td><td><span class:list={["pill", status === "Confirmed" ? "good" : "info"]}>{status}</span></td><td class="mono">{surface}</td></tr>)}</tbody></table></section>
</ControlPlaneLayout>
