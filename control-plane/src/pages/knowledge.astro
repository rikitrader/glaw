---
import ControlPlaneLayout from "../layouts/ControlPlaneLayout.astro";
const collections = [["global-legal", "Global Legal Knowledge", "Lexical + citation graph", "Confirmed", "7,204"], ["jurisdiction-us", "US Jurisdiction Knowledge", "Source-locked", "Confirmed", "2,918"], ["matter-local-001", "Matter: GLAW-LOCAL-001", "Permissioned matter scope", "Proposed", "0"], ["evidence-local", "Evidence", "Immutable originals", "Proposed", "0"]];
---
<ControlPlaneLayout title="Knowledge / RAG" eyebrow="KNOWLEDGE / 00" active="knowledge" description="GLAW permissioned knowledge and RAG control">
  <section class="page-intro"><div><p class="eyebrow">KNOWLEDGE CONTROL</p><h1>Every answer has a <em>source.</em></h1></div><div><p class="page-intro-copy">Retrieval authorization happens before search. The current baseline is source-locked lexical and citation-graph retrieval; semantic Vectorize is not enabled.</p><div class="page-actions"><a class="secondary-action" href="/architecture">RAG architecture</a><a class="primary-action" href="/knowledge/ingest">＋ Ingest source</a></div></div></section>
  <section class="metrics"><article class="metric"><p class="metric-label">Collections</p><strong class="metric-value">07</strong><span class="metric-note good">Registry loaded</span></article><article class="metric"><p class="metric-label">Semantic index</p><strong class="metric-value">OFF</strong><span class="metric-note warn">Vectorize not configured</span></article><article class="metric"><p class="metric-label">Citation graph</p><strong class="metric-value">ON</strong><span class="metric-note good">Confirmed baseline</span></article><article class="metric"><p class="metric-label">Permission filter</p><strong class="metric-value">REQUIRED</strong><span class="metric-note warn">Before retrieval</span></article></section>
  <section class="content-grid"><article class="panel"><div class="panel-head"><div><p class="eyebrow">COLLECTION REGISTRY</p><h2>Knowledge collections</h2></div><a href="/knowledge/policies">Access policy →</a></div><table class="table"><thead><tr><th>Collection</th><th>Retrieval</th><th>Status</th><th>Documents</th></tr></thead><tbody>{collections.map(([id, name, retrieval, status, docs]) => <tr><td><a href={`/knowledge/${id}`}><strong>{name}</strong><small class="mono">{id}</small></a></td><td>{retrieval}</td><td><span class:list={["pill", status === "Confirmed" ? "good" : "info"]}>{status}</span></td><td class="mono">{docs}</td></tr>)}</tbody></table></article><article class="panel"><div class="panel-head"><div><p class="eyebrow">RETRIEVAL PIPELINE</p><h2>Source path</h2></div><a href="/architecture">Inspect →</a></div><div class="pipeline">{["Source", "Classify", "Normalize", "Cite", "Authorize", "Retrieve", "Validate"].map((step, i) => <div><span>0{i + 1}</span><strong>{step}</strong>{i < 6 && <b>↓</b>}</div>)}</div></article></section>
</ControlPlaneLayout>

<style>.pipeline { margin-top: 16px; display: grid; gap: 0; }.pipeline div { display: flex; align-items: center; gap: 10px; min-height: 35px; border-bottom: 1px solid rgba(243,240,232,.08); }.pipeline span { width: 20px; color: #d7a84b; font: 10px monospace; }.pipeline strong { font-size: 12px; }.pipeline b { color: #687982; margin-left: auto; }</style>
