    "net_FX_position": "FX_assets - FX_liabilities",
    "FX_capital_ratio": "net_FX_position / capital",
    "liquidity_gap": "assets_bucket - liabilities_bucket",
    "cumulative_gap": "sum(liquidity_gap through bucket)",
