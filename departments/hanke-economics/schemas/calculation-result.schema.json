    "formula":{"type":"string"}, "inputs":{"type":"object"}, "result":{"type":"number"}, "unit":{"type":"string"},
    "date":{"type":"string"}, "source_data":{"type":"array","items":{"type":"string"}}, "assumptions":{"type":"array","items":{"type":"string"}},
    "verification":{"enum":["PASS","REVIEW","FAIL"]}
  },
  "additionalProperties": false
}
