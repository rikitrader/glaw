{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaw.local/haeis/schemas/debt-obligation.schema.json",
  "title": "Venezuela underlying debt obligation",
  "type": "object",
  "required": ["economic_exposure_id", "issuer_class", "creditor", "currency", "as_of_date", "verification_status"],
  "properties": {
    "economic_exposure_id": {"type":"string"},
    "issuer_class": {"enum":["REPUBLIC","PDVSA","ELECAR","OTHER_SOE","BILATERAL","MULTILATERAL","DOMESTIC","CONTINGENT_CLAIM"]},
    "creditor": {"type":"string"},
    "underlying_obligation": {"type":"string"},
    "instrument_id": {"type":["string","null"]},
    "isin": {"type":["string","null"]},
    "original_principal": {"type":["number","null"]},
    "principal_outstanding": {"type":["number","null"]},
    "accrued_interest": {"type":["number","null"]},
    "currency": {"type":"string"},
    "governing_law": {"type":["string","null"]},
    "maturity_date": {"type":["string","null"]},
    "default_date": {"type":["string","null"]},
    "as_of_date": {"type":"string"},
    "source_document_ids": {"type":"array","items":{"type":"string"}},
    "verification_status": {"enum":["VERIFIED","FOUND","UNVERIFIED","RESTRICTED","DISPUTED","UNAVAILABLE"]},
    "overlap_ids": {"type":"array","items":{"type":"string"}},
    "notes": {"type":"string"}
  }
}
