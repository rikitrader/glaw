      "pdfua_tag" : "LI",
      "page number" : 2,
      "bounding box" : [ 100.22, 266.154, 513.096, 293.992 ],
      "font" : "SymbolMT",
      "font size" : 11.52,
      "text color" : "[0.0235, 0.0235, 0.376]",
      "content" : "• Al realizar compras por Internet, hazlo en comercios que garanticen la confidencialidad de tus datos personales y de tu tarjeta.",
