      "pdfua_tag" : "LI",
      "page number" : 2,
      "bounding box" : [ 100.22, 335.994, 513.095, 363.712 ],
      "font" : "SymbolMT",
      "font size" : 11.52,
      "text color" : "[0.0235, 0.0235, 0.376]",
      "content" : "• Evita perder de vista tu tarjeta de crédito al pagar en establecimientos comerciales, y verifica que sea la tuya cuando te la devuelvan.",
      "kids" : [ ]
    }, {
      "type" : "list item",
