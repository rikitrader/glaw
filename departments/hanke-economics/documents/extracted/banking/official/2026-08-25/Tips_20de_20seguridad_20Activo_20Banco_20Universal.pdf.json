      "page number" : 3,
      "bounding box" : [ 100.22, 472.814, 506.884, 487.092 ],
      "font" : "SymbolMT",
      "font size" : 11.52,
      "text color" : "[0.0235, 0.0235, 0.376]",
      "content" : "• No prestes tu tarjeta ni permitas que otras personas la usen a tu nombre.",
