      "bounding box" : [ 100.22, 570.644, 452.155, 584.922 ],
      "font" : "SymbolMT",
      "font size" : 11.52,
      "text color" : "[0.0235, 0.0235, 0.376]",
      "content" : "• Nunca proporciones tu contraseña de tarjeta a ningún extraño.",
      "kids" : [ ]
    }, {
      "type" : "list item",
      "pdfua_tag" : "LI",
      "page number" : 3,
