{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaw.local/schemas/audit-event.schema.json",
  "title": "GLAW Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "tenantId", "actorId", "traceId", "occurredAt", "payload", "eventHash"],
  "properties": {
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "matterId": { "type": "string" },
    "actorId": { "type": "string", "minLength": 1 },
    "traceId": { "type": "string", "minLength": 1 },
    "commandId": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "previousHash": { "type": "string" },
    "eventHash": { "type": "string", "minLength": 1 }
  }
}
