---
const apiBase = import.meta.env.PUBLIC_GLAW_API_BASE_URL ?? '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GLAW Global Judicial Mesh operations dashboard" />
    <title>GLAW / Judicial Mesh</title>
  </head>
  <body data-api-base={apiBase}>
    <div class="shell">
      <aside class="sidebar" aria-label="Primary navigation">
        <div class="brand"><span class="brand-mark">G</span><div><strong>GLAW</strong><small>JUDICIAL MESH</small></div></div>
        <nav>
          <a class="nav-item active" href="#overview"><span>◉</span>Overview</a>
          <a class="nav-item" href="#providers"><span>⊞</span>Providers</a>
          <a class="nav-item" href="#activity"><span>↗</span>Activity</a>
          <a class="nav-item" href="#controls"><span>⚙</span>Controls</a>
        </nav>
        <div class="sidebar-foot"><span class="pulse"></span><span id="connection-label">Connecting</span><button id="refresh-button" class="quiet-button">Refresh</button></div>
      </aside>
      <main class="content">
        <header class="topbar"><div><p class="eyebrow">OPERATIONS / GLOBAL LEGAL RESEARCH</p><h1>Mesh control room</h1><p class="subtitle">Source coverage, review gates, and ingestion health in one place.</p></div><div class="top-actions"><label class="token-field"><span>API token</span><input id="api-token" type="password" placeholder="session only" autocomplete="off" /></label><button id="token-button" class="button secondary">Use token</button></div></header>
        <section id="overview" class="hero-row"><div class="status-card"><div><span class="label">RUNTIME</span><strong id="runtime">—</strong></div><span id="mode-badge" class="badge">Loading</span></div><p id="notice" class="notice" role="status">Loading dashboard telemetry…</p></section>
        <section class="metric-grid" aria-label="Mesh summary">
          <article class="metric-card"><span class="label">Providers active</span><strong id="active-providers">—</strong><small id="provider-breakdown">—</small></article>
          <article class="metric-card"><span class="label">Indexed cases</span><strong id="indexed-cases">—</strong><small>Canonical records in D1</small></article>
          <article class="metric-card"><span class="label">Ingestion events</span><strong id="ingestion-events">—</strong><small>Queue receipts recorded</small></article>
          <article class="metric-card accent"><span class="label">Review ready</span><strong id="review-ready">—</strong><small>Awaiting explicit activation</small></article>
        </section>
        <section id="providers" class="panel"><div class="panel-head"><div><span class="eyebrow">SOURCE ROUTER</span><h2>Provider posture</h2></div><span id="provider-count" class="panel-meta">—</span></div><div class="table-wrap"><table><thead><tr><th>Provider</th><th>Coverage</th><th>Capabilities</th><th>Review</th><th>Route</th></tr></thead><tbody id="provider-rows"><tr><td colspan="5" class="empty">Loading providers…</td></tr></tbody></table></div></section>
        <section id="activity" class="lower-grid"><div class="panel"><div class="panel-head"><div><span class="eyebrow">INGESTION</span><h2>Recent activity</h2></div></div><div id="activity-list" class="activity-list"><div class="empty">Loading activity…</div></div></div><div id="controls" class="panel controls"><div class="panel-head"><div><span class="eyebrow">CONTROL PLANE</span><h2>Review gates</h2></div></div><p>Providers remain non-routable until terms, schema, authority, and security evidence are approved by an administrator.</p><div class="gate-list"><span><i class="gate-dot"></i>Terms review</span><span><i class="gate-dot"></i>Schema validation</span><span><i class="gate-dot"></i>Authority validation</span><span><i class="gate-dot"></i>Security review</span></div><a class="text-link" href="#providers">Inspect provider posture →</a></div></section>
        <footer>GLAW Global Judicial Mesh <span>•</span> Dashboard data is operational metadata, not legal advice.</footer>
      </main>
    </div>
    <script>
      const root = document.body;
      const apiBase = root.dataset.apiBase || window.location.origin;
      const tokenInput = document.querySelector('#api-token');
      const savedToken = sessionStorage.getItem('glaw-api-token') || '';
      tokenInput.value = savedToken;
      const authHeaders = () => savedToken || tokenInput.value ? { Authorization: `Bearer ${savedToken || tokenInput.value}` } : {};
      const get = async (path) => { const response = await fetch(`${apiBase}${path}`, { headers: authHeaders() }); if (!response.ok) throw new Error(`${response.status} ${response.statusText}`); return response.json(); };
      const text = (id, value) => { const node = document.querySelector(id); if (node) node.textContent = value; };
      const format = (value) => new Intl.NumberFormat().format(value || 0);
      const load = async () => { try { const [summary, providers, activity] = await Promise.all([get('/v1/dashboard/summary'), get('/v1/dashboard/providers'), get('/v1/dashboard/activity')]); text('#connection-label', 'Connected'); text('#runtime', summary.environment); text('#active-providers', `${summary.providers.active} / ${summary.providers.total}`); text('#provider-breakdown', `${summary.providers.inactive} inactive · ${summary.providers.reviewReady} ready`); text('#indexed-cases', format(summary.corpus.indexedCases)); text('#ingestion-events', format(summary.corpus.ingestionEvents)); text('#review-ready', format(summary.providers.reviewReady)); text('#provider-count', `${summary.providers.total} registered`); const badge = document.querySelector('#mode-badge'); badge.textContent = summary.mockMode ? 'LOCAL MOCK' : 'PRODUCTION'; badge.className = `badge ${summary.mockMode ? 'mock' : 'live'}`; text('#notice', summary.mockMode ? 'Synthetic fixtures are enabled. No record on this screen is legal authority.' : 'Live operational metadata. Provider activation remains policy-gated.'); document.querySelector('#provider-rows').innerHTML = providers.providers.map((provider) => `<tr><td><strong>${provider.id}</strong><small>${provider.jurisdiction.join(' · ')}</small></td><td>${provider.coverageCount} lanes</td><td>${provider.capabilities.search ? 'Search' : 'Metadata only'}</td><td><span class="state ${provider.review.lifecycle.toLowerCase()}">${provider.review.lifecycle}</span></td><td><span class="route ${provider.routable ? 'on' : 'off'}">${provider.routable ? 'ROUTABLE' : 'BLOCKED'}</span></td></tr>`).join(''); const rows = [...activity.ingestion.map((item) => ({ label: `${item.provider} · ${item.kind}`, meta: item.created_at })), ...activity.activations.map((item) => ({ label: `${item.provider_id} · ${item.event_type}`, meta: item.created_at }))].slice(0, 8); document.querySelector('#activity-list').innerHTML = rows.length ? rows.map((item) => `<div class="activity-item"><span class="activity-mark"></span><div><strong>${item.label}</strong><small>${item.meta || 'recent'}</small></div></div>`).join('') : '<div class="empty">No activity recorded.</div>'; } catch (error) { text('#connection-label', 'Needs token'); text('#notice', `Dashboard unavailable: ${error.message}`); } };
      document.querySelector('#refresh-button').addEventListener('click', load);
      document.querySelector('#token-button').addEventListener('click', () => { sessionStorage.setItem('glaw-api-token', tokenInput.value); load(); });
      load();
    </script>
  </body>
</html>
<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
  :root { --ink:#10211f; --muted:#667572; --line:#dfe7e2; --paper:#f5f7f2; --panel:#fff; --green:#1e6b58; --mint:#d9eee3; --amber:#e5b45a; --red:#b24c42; }
  * { box-sizing:border-box; } body { margin:0; color:var(--ink); background:var(--paper); font-family:Manrope,system-ui,sans-serif; } .shell { display:flex; min-height:100vh; }
  .sidebar { width:232px; background:#10211f; color:#eaf3ed; display:flex; flex-direction:column; padding:28px 18px 20px; position:fixed; inset:0 auto 0 0; } .brand { display:flex; gap:11px; align-items:center; padding:0 10px 40px; } .brand-mark { width:33px; height:33px; display:grid; place-items:center; color:#10211f; background:var(--amber); border-radius:9px; font-weight:800; } .brand strong,.brand small { display:block; } .brand strong { letter-spacing:.16em; font-size:14px; } .brand small { color:#8ea49a; letter-spacing:.12em; font:10px 'DM Mono',monospace; margin-top:3px; }
  nav { display:grid; gap:6px; } .nav-item { color:#a6bab0; text-decoration:none; padding:12px 13px; border-radius:7px; font-size:13px; display:flex; gap:12px; align-items:center; } .nav-item span { width:15px; color:#789388; } .nav-item.active,.nav-item:hover { color:#fff; background:#1b3933; } .nav-item.active span { color:var(--amber); } .sidebar-foot { margin-top:auto; display:flex; gap:8px; align-items:center; color:#90a49c; font:10px 'DM Mono',monospace; padding:10px; } .pulse { width:7px;height:7px;border-radius:50%;background:#6dc890; box-shadow:0 0 0 4px #23483b; } .quiet-button { margin-left:auto; background:none;border:0;color:#8ea49a;font:10px 'DM Mono',monospace;cursor:pointer; }
  .content { margin-left:232px; width:calc(100% - 232px); max-width:1500px; padding:42px clamp(24px,5vw,72px); } .topbar,.hero-row,.panel-head { display:flex; justify-content:space-between; gap:24px; } .eyebrow,.label { color:var(--green); font:500 10px 'DM Mono',monospace; letter-spacing:.12em; } h1,h2,p { margin:0; } h1 { font-size:clamp(29px,3vw,42px); letter-spacing:-.05em; margin-top:9px; } h2 { font-size:18px; letter-spacing:-.03em; margin-top:7px; } .subtitle { color:var(--muted); font-size:13px; margin-top:8px; } .top-actions { display:flex; align-items:end; gap:8px; } .token-field span { display:block;color:var(--muted);font:10px 'DM Mono',monospace;margin:0 0 5px 2px; } input { width:150px;border:1px solid var(--line);background:#fff;padding:10px 11px;border-radius:6px;font:11px 'DM Mono',monospace; } .button { border:1px solid var(--green);padding:10px 13px;border-radius:6px;font:600 11px Manrope;cursor:pointer; } .button.secondary { background:var(--green);color:#fff; }
  .hero-row { align-items:center; margin:42px 0 16px; } .status-card { background:var(--ink);color:#fff;padding:18px 20px;display:flex;align-items:center;gap:24px;min-width:245px;border-radius:8px; } .status-card .label { color:#9ab2a8; } .status-card strong { display:block;font-size:19px;margin-top:4px; } .badge,.state,.route { font:500 10px 'DM Mono',monospace; letter-spacing:.08em; } .badge { padding:7px 9px;border-radius:99px;background:#344b45;color:#dcece2; } .badge.mock { background:#674c1d;color:#ffe4a7; }.badge.live { background:#285b4c;color:#c9f1db; } .notice { color:var(--muted);font-size:12px;max-width:470px;text-align:right; }
  .metric-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:30px; } .metric-card { background:var(--panel);border:1px solid var(--line);padding:19px 20px;border-radius:8px;min-height:120px; } .metric-card.accent { background:var(--mint);border-color:#c0dfcf; } .metric-card strong { display:block;font-size:30px;letter-spacing:-.06em;margin:13px 0 3px; } .metric-card small,.table-wrap small,.activity-item small { color:var(--muted);font-size:11px;display:block; }
  .panel { background:var(--panel);border:1px solid var(--line);border-radius:8px;overflow:hidden; } .panel-head { align-items:start;padding:21px 22px;border-bottom:1px solid var(--line); } .panel-meta { color:var(--muted);font:11px 'DM Mono',monospace;margin-top:4px; } .table-wrap { overflow:auto; } table { width:100%;border-collapse:collapse;font-size:12px; } th { text-align:left;color:var(--muted);font:10px 'DM Mono',monospace;font-weight:500;letter-spacing:.08em;padding:12px 22px;background:#fafbf8; } td { padding:15px 22px;border-top:1px solid #edf1ed;white-space:nowrap; } td strong { font-size:12px; } .state,.route { display:inline-block;padding:6px 8px;border-radius:4px; } .state.discovered,.state.security_review,.state.terms_review,.state.schema_test,.state.authority_test { color:#8b6828;background:#fff1cc; } .state.active { color:#236848;background:#ddf1e4; } .route.on { color:#236848; }.route.off { color:#a34b40; }
  .lower-grid { display:grid;grid-template-columns:1.2fr .8fr;gap:14px;margin-top:14px; } .activity-list { padding:8px 22px 14px; }.activity-item { display:flex;gap:12px;align-items:center;padding:13px 0;border-bottom:1px solid #edf1ed; }.activity-item:last-child{border:0}.activity-mark { width:8px;height:8px;background:var(--amber);border-radius:50%; }.activity-item strong { display:block;font-size:12px; }.controls { padding-bottom:24px; }.controls > p { padding:18px 22px 5px;color:var(--muted);font-size:12px;line-height:1.6; }.gate-list { display:grid;gap:9px;padding:13px 22px 18px; }.gate-list span { font-size:12px; }.gate-dot { display:inline-block;width:7px;height:7px;border:2px solid var(--amber);border-radius:50%;margin-right:9px; }.text-link { color:var(--green);font-size:12px;font-weight:700;text-decoration:none;padding:0 22px; }.empty { color:var(--muted);padding:24px;text-align:center;font-size:12px; } footer { color:#83918c;font:10px 'DM Mono',monospace;padding:24px 0 10px; } footer span { color:var(--amber);padding:0 5px; }
  @media (max-width:1024px) { .sidebar { width:72px;padding:22px 10px; }.brand { padding:0 9px 35px; }.brand div, .nav-item:not(.active)::after,.nav-item { font-size:0; }.nav-item { justify-content:center;padding:13px; }.nav-item span { font-size:15px;text-align:center; }.sidebar-foot { justify-content:center; }.sidebar-foot span:not(.pulse),.quiet-button { display:none; }.content { margin-left:72px;width:calc(100% - 72px); }.metric-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:700px) { .content { padding:28px 16px; }.topbar { display:block; }.top-actions { margin-top:20px; }.hero-row { display:block;margin-top:30px; }.notice { text-align:left;margin-top:12px; }.metric-grid { grid-template-columns:1fr 1fr;gap:8px; }.metric-card { padding:15px;min-height:105px; }.metric-card strong { font-size:24px; }.lower-grid { grid-template-columns:1fr; }.panel-head { padding:17px; } th,td { padding-left:15px;padding-right:15px; }.token-field { flex:1; }.token-field input { width:100%; } }
  @media (prefers-reduced-motion:reduce) { * { scroll-behavior:auto !important;transition:none !important; } }
</style>
