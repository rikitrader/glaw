{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glaw-global-judicial-mesh-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [{ "binding": "DB", "database_name": "glaw-judicial-mesh-local", "database_id": "local", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "glaw-judicial-documents-local" }],
  "kv_namespaces": [{ "binding": "CACHE", "id": "local" }],
  "queues": { "producers": [{ "binding": "INGESTION_QUEUE", "queue": "glaw-judicial-ingestion-local" }], "consumers": [{ "queue": "glaw-judicial-ingestion-local", "max_batch_size": 20, "max_batch_timeout": 30, "max_retries": 5 }] },
  "vectorize": [{ "binding": "LEGAL_VECTORS", "index_name": "glaw-legal-v1-local" }],
  "durable_objects": { "bindings": [{ "name": "ROUTER_COORDINATOR", "class_name": "RouterCoordinator" }, { "name": "JUDGE_PROFILE_COORDINATOR", "class_name": "JudgeProfileCoordinator" }, { "name": "MATTER_COORDINATOR", "class_name": "MatterCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RouterCoordinator"] }, { "tag": "v2", "new_sqlite_classes": ["JudgeProfileCoordinator"] }, { "tag": "v3", "new_sqlite_classes": ["MatterCoordinator"] }],
  "vars": { "ENVIRONMENT": "local", "MOCK_PROVIDER_MODE": "true", "COURTLISTENER_BASE_URL": "https://www.courtlistener.com/api/rest/v4", "GLAW_RATE_LIMIT_PER_MINUTE": "120", "GLAW_ADMIN_API_KEY": "local-smoke-admin" }
}
