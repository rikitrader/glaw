#!/usr/bin/env python3
"""Deterministic guidance range and probability-weighted scenario engine."""
import argparse, json, pathlib, sys

def main():
    p = argparse.ArgumentParser(prog="glaw-guidance-scenarios"); p.add_argument("input"); args = p.parse_args()
    try: data = json.loads(pathlib.Path(args.input).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e: print(f"cannot read JSON: {e}", file=sys.stderr); return 2
    scenarios = data.get("scenarios", [])
    if not scenarios or abs(sum(float(s.get("probability_pct", 0)) for s in scenarios) - 100) > 1e-6: print("scenarios must be non-empty and probabilities must sum to 100", file=sys.stderr); return 2
    metrics = set(scenarios[0].get("metrics", {}))
    if not metrics: print("scenarios require metrics", file=sys.stderr); return 2
    result = {"guidance_id": data.get("guidance_id", ""), "recommended_action": data.get("recommended_action", "review"), "weighted_metrics": {}}
    for metric in metrics:
        result["weighted_metrics"][metric] = round(sum(float(s["metrics"].get(metric, 0)) * float(s["probability_pct"]) / 100 for s in scenarios), 8)
    result["range"] = {metric: {"min": min(float(s["metrics"].get(metric, 0)) for s in scenarios), "max": max(float(s["metrics"].get(metric, 0)) for s in scenarios)} for metric in metrics}
    print(json.dumps(result, indent=2, sort_keys=True)); return 0

if __name__ == "__main__": raise SystemExit(main())
