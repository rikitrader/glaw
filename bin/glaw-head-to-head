#!/usr/bin/env python3
"""Compare two analytical-review scorecards with material-error penalties."""
import argparse, json, pathlib, sys

def load(p):
    try: return json.loads(pathlib.Path(p).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as e: raise ValueError(f"cannot read JSON: {e}")

def score(obj):
    scores = obj.get("scores", {}); total = sum(float(scores.get(k, 0)) for k in ("source_accuracy", "model_integrity", "valuation_soundness", "assumption_quality", "scenario_quality", "recommendation_quality"))
    penalty = min(30, len(obj.get("material_errors", [])) * 15 + len(obj.get("unsupported_claims", [])) * 3)
    return max(0, total - penalty)

def main():
    p = argparse.ArgumentParser(prog="glaw-head-to-head"); p.add_argument("left"); p.add_argument("right"); args = p.parse_args()
    try:
        left, right = load(args.left), load(args.right); ls, rs = score(left), score(right)
        winner = "tie" if ls == rs else ("left" if ls > rs else "right")
        print(json.dumps({"left_score": ls, "right_score": rs, "winner": winner, "material_error_penalty_applied": True, "human_adjudication_required": winner == "tie" or bool(left.get("material_errors") or right.get("material_errors"))}, indent=2, sort_keys=True)); return 0
    except ValueError as e: print(str(e), file=sys.stderr); return 2

if __name__ == "__main__": raise SystemExit(main())
