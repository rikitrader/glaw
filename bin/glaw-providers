#!/usr/bin/env python3
"""Inspect and smoke-test explicitly configured Legal Governor providers."""
from __future__ import annotations
import argparse, hashlib, json, os, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
from legal_governor.providers import ProviderResultStatus, configured_agent_provider, health_all
from legal_governor.audit_log import append

def main() -> int:
    parser = argparse.ArgumentParser(prog="glaw-providers")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    check = sub.add_parser("check")
    check.add_argument("provider", choices=["claude", "codex"])
    smoke = sub.add_parser("smoke")
    smoke.add_argument("provider", choices=["claude", "codex", "both"], default="both", nargs="?")
    args = parser.parse_args()
    if args.command == "status":
        print(json.dumps(health_all(), indent=2, sort_keys=True))
        return 0
    if args.command == "check":
        agent = "alexandra_vale" if args.provider == "claude" else "victor_sterling"
        print(json.dumps({agent: health_all()[agent]}, indent=2, sort_keys=True))
        return 0
    agents = {"claude": "alexandra_vale", "codex": "victor_sterling"} if args.provider != "both" else {"claude": "alexandra_vale", "codex": "victor_sterling"}
    results = {}
    schema = {"type": "object", "properties": {"status": {"type": "string"}}, "required": ["status"]}
    for provider_name, agent_id in agents.items():
        if args.provider not in {"both", provider_name}: continue
        provider = configured_agent_provider(agent_id)
        result = provider.analyze('Return valid JSON exactly: {"status":"ok"}', matter_id="provider-smoke", agent_id=agent_id, output_schema=schema)
        audit_path = Path(os.environ.get("PROVIDER_AUDIT_LOG", str(ROOT / "workpapers" / "provider-audit.jsonl")))
        append(audit_path, {"event": "PROVIDER_CALL", "run_id": f"provider-smoke-{provider_name}", "matter_id": "provider-smoke", "agent_id": agent_id, "provider": result.provider, "mode": result.mode, "execution_mode": result.mode, "model": result.model, "cli_version": result.cli_version, "started_at": result.started_at, "completed_at": result.completed_at, "exit_code": result.exit_code, "timeout": result.status == ProviderResultStatus.TIMEOUT.value, "status": result.status, "input_hash": hashlib.sha256(b'Return valid JSON exactly: {"status":"ok"}').hexdigest(), "output_hash": None, "fallback_used": result.fallback_used, "error_code": result.error_code})
        results[provider_name] = {"provider": provider_name, "mode": result.mode, "status": result.status, "cli_version": result.cli_version, "authenticated": result.authenticated, "fallback_used": result.fallback_used, "error_code": result.error_code, "error_message": result.error_message, "parsed_output": result.parsed_output}
    print(json.dumps(results, indent=2, sort_keys=True))
    return 0 if all(row["status"] == ProviderResultStatus.SUCCESS.value for row in results.values()) else 1

if __name__ == "__main__":
    raise SystemExit(main())
