#!/usr/bin/env python3
"""Deterministic scaffold, validator, and scorecard for analytical-artifact reviews."""
import argparse, json, pathlib, sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
REQUIRED_SCORE_KEYS = {
    "source_accuracy": 20,
    "model_integrity": 25,
    "valuation_soundness": 20,
    "assumption_quality": 15,
    "scenario_quality": 10,
    "recommendation_quality": 10,
}
DECISIONS = {"approve", "approved_with_conditions", "revise_required", "reject", "insufficient_evidence"}

def load(path):
    try:
        return json.loads(pathlib.Path(path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot read JSON: {exc}") from exc

def validate(obj):
    errors = []
    for key in ("review_id", "artifact_type", "artifact_version", "reviewer", "scores", "decision", "human_approval_required"):
        if key not in obj:
            errors.append(f"missing required field: {key}")
    if "review_id" in obj and (not isinstance(obj["review_id"], str) or not obj["review_id"].startswith("AR-")):
        errors.append("review_id must start with AR-")
    scores = obj.get("scores", {})
    if not isinstance(scores, dict):
        errors.append("scores must be an object")
    else:
        for key, maximum in REQUIRED_SCORE_KEYS.items():
            value = scores.get(key)
            if not isinstance(value, (int, float)) or isinstance(value, bool):
                errors.append(f"scores.{key} must be numeric")
            elif value < 0 or value > maximum:
                errors.append(f"scores.{key} must be between 0 and {maximum}")
    if obj.get("decision") not in DECISIONS:
        errors.append(f"decision must be one of: {', '.join(sorted(DECISIONS))}")
    if not isinstance(obj.get("human_approval_required"), bool):
        errors.append("human_approval_required must be boolean")
    if "confidence" in obj and (not isinstance(obj["confidence"], (int, float)) or not 0 <= obj["confidence"] <= 100):
        errors.append("confidence must be between 0 and 100")
    if not isinstance(obj.get("material_errors", []), list):
        errors.append("material_errors must be an array")
    return errors

def score(obj):
    errors = validate(obj)
    if errors:
        raise ValueError("invalid review: " + "; ".join(errors))
    total = sum(obj["scores"].values())
    material = len(obj.get("material_errors", []))
    unsupported = len(obj.get("unsupported_claims", []))
    penalty = min(30, material * 15 + unsupported * 3)
    adjusted = max(0, total - penalty)
    if material:
        band = "revise_required"
    elif adjusted >= 85:
        band = "strong"
    elif adjusted >= 70:
        band = "acceptable_with_conditions"
    else:
        band = "weak"
    return {"raw_score": total, "penalty": penalty, "adjusted_score": adjusted, "band": band, "material_error_count": material, "unsupported_claim_count": unsupported}

def scaffold(args):
    return {
        "review_id": args.review_id,
        "deal_or_matter_id": args.matter,
        "artifact_type": args.artifact_type,
        "artifact_version": "v1",
        "producer": "",
        "reviewer": "glaw-fs-analytical-artifact-review",
        "source_set": [],
        "scores": {key: 0 for key in REQUIRED_SCORE_KEYS},
        "material_errors": [],
        "unsupported_claims": [],
        "required_corrections": [],
        "decision": "insufficient_evidence",
        "confidence": 0,
        "human_approval_required": True,
    }

def main():
    parser = argparse.ArgumentParser(prog="glaw-analytical-review")
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("scaffold")
    p.add_argument("--review-id", required=True)
    p.add_argument("--matter", default="")
    p.add_argument("--artifact-type", default="other", choices=["valuation_model", "investment_recommendation", "industry_analysis", "scenario_analysis", "portfolio_decision", "financial_model", "other"])
    v = sub.add_parser("validate")
    v.add_argument("input")
    s = sub.add_parser("score")
    s.add_argument("input")
    args = parser.parse_args()
    try:
        if args.command == "scaffold":
            print(json.dumps(scaffold(args), indent=2, sort_keys=True))
            return 0
        obj = load(args.input)
        errors = validate(obj)
        if args.command == "validate":
            print(json.dumps({"valid": not errors, "errors": errors}, indent=2, sort_keys=True))
            return 0 if not errors else 1
        print(json.dumps(score(obj), indent=2, sort_keys=True))
        return 0
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2

if __name__ == "__main__":
    raise SystemExit(main())
