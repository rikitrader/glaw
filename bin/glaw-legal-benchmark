#!/usr/bin/env python3
"""GLAW attorney benchmark lifecycle CLI."""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
from legal_governor import benchmark  # noqa: E402
from legal_governor.benchmark_evaluation import evaluate  # noqa: E402


def benchmark_root() -> Path:
    return Path(os.environ.get("GLAW_BENCHMARK_HOME", str(ROOT / "benchmarks" / "legal-10k"))).expanduser().resolve()


def read_json(path: str) -> dict:
    return json.loads(Path(path).read_text(encoding="utf-8"))


def read_jsonl(path: str) -> list[dict]:
    return [json.loads(line) for line in Path(path).read_text(encoding="utf-8").splitlines() if line.strip()]


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="glaw-legal-benchmark")
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("scaffold")
    p.add_argument("--overwrite", action="store_true")
    p = sub.add_parser("validate")
    p.add_argument("--require-released", action="store_true")
    sub.add_parser("audit")
    p = sub.add_parser("import")
    p.add_argument("--input", required=True)
    p = sub.add_parser("reviewer-register")
    p.add_argument("--input", required=True)
    p = sub.add_parser("review")
    p.add_argument("--input", required=True)
    p = sub.add_parser("adjudicate")
    p.add_argument("--input", required=True)
    sub.add_parser("release")
    sub.add_parser("split")
    p = sub.add_parser("evaluate")
    p.add_argument("--input", required=True)
    args = parser.parse_args(argv)
    root = benchmark_root()
    if args.command == "scaffold":
        result = benchmark.scaffold(root, overwrite=args.overwrite)
    elif args.command == "validate":
        failures = benchmark.validate(root, require_released=args.require_released)
        result = {"status": "PASS" if not failures else "BLOCK", "failures": failures}
    elif args.command == "audit":
        result = benchmark.audit(root)
    elif args.command == "import":
        result = benchmark.import_items(root, read_jsonl(args.input))
    elif args.command == "reviewer-register":
        result = benchmark.register_reviewer(root, read_json(args.input))
    elif args.command == "review":
        result = benchmark.add_review(root, read_json(args.input))
    elif args.command == "adjudicate":
        result = benchmark.adjudicate(root, read_json(args.input))
    elif args.command == "release":
        result = benchmark.release(root)
    elif args.command == "split":
        rows = benchmark.read_jsonl(benchmark.paths(root)["items"])
        result = {"status": "PASS", "counts": {split: sum(row.get("split") == split for row in rows) for split in benchmark.SPLITS}}
    else:
        result = evaluate(root, read_jsonl(args.input))
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if result.get("status", "PASS") in {"PASS", "pass", "not_required"} or args.command == "split" else 1


if __name__ == "__main__":
    raise SystemExit(main())

