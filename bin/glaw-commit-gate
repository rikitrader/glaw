#!/usr/bin/env bash
# glaw-commit-gate — local Git safety gate for GLAW.
set -euo pipefail

mode="${1:-manual}"
ROOT="${GLAW_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || true)}"
if [ -z "$ROOT" ] || [ ! -d "$ROOT" ]; then
  echo "GLAW COMMIT GATE BLOCKED: cannot resolve repo root; set GLAW_ROOT." >&2
  exit 1
fi
cd "$ROOT"

if [ "$mode" = "pre-commit" ]; then
  ssot_changed="$(git diff --cached --name-only -- lib/glaw_profiles.py lib/firm-roster.md 2>/dev/null || true)"
  if [ -n "$ssot_changed" ] && [ -z "${GLAW_SSOT_OWNER:-}" ]; then
    echo "GLAW COMMIT GATE BLOCKED: SSOT files require an explicit single owner." >&2
    echo "$ssot_changed" | sed 's/^/  - /' >&2
    echo "Set GLAW_SSOT_OWNER='<name/team>' only after coordinating the lock." >&2
    exit 1
  fi
fi

echo "GLAW commit gate ($mode): running bin/glaw-doctor"
DOCTOR_TIMEOUT_SECONDS="${GLAW_DOCTOR_TIMEOUT_SECONDS:-900}"
doctor_runner=(bash bin/glaw-doctor)

if command -v timeout >/dev/null 2>&1; then
  doctor_runner=(timeout "$DOCTOR_TIMEOUT_SECONDS" bash bin/glaw-doctor)
elif command -v gtimeout >/dev/null 2>&1; then
  doctor_runner=(gtimeout "$DOCTOR_TIMEOUT_SECONDS" bash bin/glaw-doctor)
fi

set +e
"${doctor_runner[@]}"
rc=$?
set -e

if [ "$rc" -eq 0 ]; then
  echo "GLAW commit gate ($mode): PASS"
  exit 0
fi

if [ "$rc" -eq 124 ]; then
  echo "GLAW commit gate ($mode): TIMEOUT after ${DOCTOR_TIMEOUT_SECONDS}s" >&2
else
  echo "GLAW commit gate ($mode): FAIL (exit $rc)" >&2
fi
exit "$rc"
