                    "whole-client inventory across wealth management, financial planning, tax, estate/trust, business owner, risk, insurance, asset protection, investor/capital, family office, international, CFO, and dashboard lanes",
                    "each Creative Planning benchmark item classified complete, rejected, or not applicable with dated source refresh and no copied branding or claims",
                    "integrated deliverables: source/evidence binder, lane map, seat table, org chart, tax roadmap, investor/board packet, estate plan, asset-protection plan, compliance calendar, dashboard, and recurring review schedule",
                ],
                "required": lane_or_fail(data, "fortune500-enterprise").get("creative_planning_required", [])[:10],
            },
            {
                "phase": "9. RED to BLUE adversarial review and Chief decision",
                "owner": "/glaw-adversarial + /glaw-council + /glaw-legal-research + /glaw-chief-counsel",
                "outputs": [
                    "IRS, SEC, auditor/PCAOB, investor counsel, fiduciary/trustee, creditor, regulator, opposing counsel, valuation/appraiser, and outside-critic attacks",
                    "citation gate, source corpus, groundedness, reviewer identity, professional report quality, UPL, compliance manifest, and premium packet freshness checks",
                    "Chief approval bound to the current final packet hash only after artifacts are fresh",
                ],
                "required": adversarial[:10],
            },
            {
                "phase": "10. Implementation, docket, and human authority boundary",
                "owner": "/glaw-file + /glaw-docket + /glaw-matter-retro + /glaw-oversight-board",
                "outputs": [
                    "implementation checklist with signer, filing party, advisor, deadline owner, dependency owner, packet artifact, and human approval condition",
                    "docket rows for SEC, Blue Sky, Form D, 83(b), 409A, tax payments, return deadlines, annual reports, trust administration, board approvals, and recurring review",
                    "no filing, signature, live transmission, payment, transfer, tax-return position, investor communication, board release, or public-company disclosure without licensed professional review and human authority",
                ],
                "gate": "final-packet and file gates remain quality gates only; human-only actions stay outside autonomous authority",
            },
        ],
        "trust_taxonomy": {
            "status": trust_report.get("status"),
            "trust_type_count": trust_report.get("trust_type_count"),
            "required_type_count": trust_report.get("required_type_count"),
            "direct_ownership_carveouts": trust_report.get("direct_ownership_carveouts", []),
            "schwab_benchmark": trust_report.get("schwab_benchmark", {}),
        },
        "source_ingest": {
            "status": source_report.get("status"),
            "source_count": source_report.get("source_count"),
            "required_source_count": source_report.get("required_source_count"),
            "extracted_char_count": source_report.get("extracted_char_count"),
            "extractor": source_report.get("extractor"),
        },
        "docket_items": docket_items,
        "adversarial_reviewers": adversarial,
        "hard_no_go": data.get("hard_no_go", []),
        "kickoff_commands": [
            "bin/glaw-intake premium fortune500-enterprise tax-system founder-unicorn uhnw-family-office",
            "bin/glaw-premium-lanes materialize-source-ingest --json",
            "bin/glaw-premium-lanes attach fortune500-enterprise",
            "bin/glaw-premium-lanes attach tax-system",
            "bin/glaw-premium-lanes attach founder-unicorn",
            "bin/glaw-premium-lanes attach uhnw-family-office",
            "bin/glaw-premium-lanes render-packet --lane fortune500-enterprise --owner \"named enterprise lead\" --source \"SRC-0001 basis\"",
            "bin/glaw-premium-lanes render-packet --lane tax-system --owner \"named tax lead\" --source \"SRC-0001 basis\"",
            "bin/glaw-premium-lanes render-packet --lane founder-unicorn --owner \"named founder lead\" --source \"SRC-0001 basis\"",
            "bin/glaw-final-packet build --profile auto",
            "bin/glaw-chief-decision --approve-final",
        ],
        "failures": failures,
        "authority": "deterministic integrated GLAW firm blueprint only; it does not give legal, tax, accounting, investment, securities, fiduciary, or public-company disclosure advice and does not file, sign, transmit, pay, transfer assets, publish, or authorize investor/board/regulator use without licensed professional review and human authority",
    }


def firm_blueprint_markdown(plan: dict[str, Any]) -> str:
    def bullets(items: list[Any]) -> str:
        return "\n".join(f"- {item}" for item in items) or "- none"

    phase_blocks = []
    for phase in plan.get("sequence", []):
        outputs = bullets(phase.get("outputs", []))
        required = bullets(phase.get("required", [])[:8])
        phase_blocks.append(
            f"## {phase.get('phase')}\n\n"
            f"Owner: {phase.get('owner')}\n\n"
            f"Gate: {phase.get('gate', 'source-backed owner/reviewer/docket proof required')}\n\n"
            f"Outputs:\n{outputs}\n\n"
            f"Required controls:\n{required}"
        )
    return f"""# Integrated GLAW Fortune 500, Tax System, Founder, Investor, and Trust Blueprint

Matter: {plan.get('matter', '')}
Source: {plan.get('source', '')}
Manifest SHA-256: {plan.get('manifest_sha256', '')}

## Component Statuses

{bullets([f"{key}: {value}" for key, value in plan.get('component_statuses', {}).items()])}

## Lanes

{bullets(plan.get('lanes', []))}

## Kickoff Commands

```bash
{chr(10).join(plan.get('kickoff_commands', []))}
```

{chr(10).join(phase_blocks)}

## Source Ingest

- status: {plan.get('source_ingest', {}).get('status')}
- sources: {plan.get('source_ingest', {}).get('source_count')} / {plan.get('source_ingest', {}).get('required_source_count')}
- extracted chars: {plan.get('source_ingest', {}).get('extracted_char_count')}

## Trust Taxonomy

- status: {plan.get('trust_taxonomy', {}).get('status')}
- trust types: {plan.get('trust_taxonomy', {}).get('trust_type_count')} / {plan.get('trust_taxonomy', {}).get('required_type_count')}

## Direct Ownership Carve-Outs

{bullets(plan.get('trust_taxonomy', {}).get('direct_ownership_carveouts', []))}

## Docket Items

{bullets(plan.get('docket_items', []))}

## Adversarial Reviewers

{bullets(plan.get('adversarial_reviewers', []))}

## Hard No-Go Controls

{bullets(plan.get('hard_no_go', []))}

## Authority Boundary

{plan.get('authority', '')}
"""


def slugify(text: str) -> str:
    out = []
    last_dash = False
    for char in text.lower():
        if char.isalnum():
            out.append(char)
            last_dash = False
        elif not last_dash:
            out.append("-")
            last_dash = True
    return "".join(out).strip("-")


def item_slug(text: str) -> str:
    slug = slugify(text) or "packet-item"
    if len(slug) <= 96:
        return slug
    digest = hashlib.sha256(text.encode("utf-8")).hexdigest()[:10]
    return f"{slug[:85].rstrip('-')}-{digest}"


def now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def require_iso_date(value: str, label: str) -> str:
    if not has_text(value):
        raise SystemExit(f"{label} is required")
    try:
        datetime.strptime(value, "%Y-%m-%d")
    except ValueError as exc:
        raise SystemExit(f"{label} must be YYYY-MM-DD") from exc
    return value


def escape_jsonl_text(value: Any) -> str:
    return str(value).replace("\\", "\\\\").replace('"', '\\"')


def matter_dir(slug: str | None) -> tuple[str, Path]:
    if not slug:
        active = GLAW_HOME / ".active"
        if not active.is_file():
            raise SystemExit("no active matter; pass --matter-slug or run: glaw matter new <name>")
        slug = active.read_text(encoding="utf-8").strip()
    if not slug:
        raise SystemExit("empty active matter slug")
    path = GLAW_HOME / "matters" / slug
    if not path.is_dir():
        raise SystemExit(f"matter not found: {slug}")
    return slug, path


def sync_intake_premium_lane(matter_path: Path, lane_id: str, ts: str) -> list[str]:
    intake_path = matter_path / "intake.json"
    try:
        intake = json.loads(intake_path.read_text(encoding="utf-8")) if intake_path.is_file() else {}
    except json.JSONDecodeError as exc:
        raise SystemExit(f"cannot sync premium lane scope; invalid intake.json: {exc}") from exc
    if not isinstance(intake, dict):
        raise SystemExit("cannot sync premium lane scope; intake.json must contain a JSON object")
    universal = intake.setdefault("universal", {})
    if not isinstance(universal, dict):
        raise SystemExit("cannot sync premium lane scope; intake universal section must be a JSON object")
    existing = universal.get("premium_lanes", [])
    if not isinstance(existing, list):
        existing = [existing]
    lanes: list[str] = []
    for value in existing:
        text = str(value or "").strip()
        if not text or text == "none":
            continue
        if text not in lanes:
            lanes.append(text)
    if lane_id not in lanes:
        lanes.append(lane_id)
    universal["premium_lanes"] = lanes
    intake.setdefault("matter_slug", matter_path.name)
    intake["updated_at"] = ts
    intake_path.write_text(json.dumps(intake, indent=2, sort_keys=False) + "\n", encoding="utf-8")
    return lanes


def attach(data: dict[str, Any], lane_id: str, slug: str | None, matter_name: str | None) -> dict[str, Any]:
    resolved_slug, path = matter_dir(slug)
    name = matter_name or resolved_slug
    packet = scaffold(data, lane_id, name)
    packet["matter_slug"] = resolved_slug
    packet["attached_at"] = now()
    packet["source_evidence"] = "evidence/zz-premium-lane-source.txt"
    intake_premium_lanes = sync_intake_premium_lane(path, lane_id, packet["attached_at"])

    evidence = path / "evidence"
    workpapers = path / "workpapers"
    evidence.mkdir(parents=True, exist_ok=True)
    workpapers.mkdir(parents=True, exist_ok=True)

    source_path = evidence / "zz-premium-lane-source.txt"
    source_path.write_text(
        "\n".join([
            "SRC premium lane scaffold basis",
            f"lane_id: {lane_id}",
            f"lane_name: {packet['lane_name']}",
            f"manifest: {MANIFEST.relative_to(ROOT)}",
            f"manifest_version: {packet.get('manifest_version')}",
            f"manifest_sha256: {packet.get('manifest_sha256')}",
            f"matter_slug: {resolved_slug}",
            f"created_at: {packet['attached_at']}",
            "purpose: source evidence for premium lane packet and docket planning",
            "",
        ]),
        encoding="utf-8",
    )

    packet_path = workpapers / f"premium-lane-{lane_id}.json"
    packet_path.write_text(json.dumps(packet, indent=2, sort_keys=False) + "\n", encoding="utf-8")

    timeline = path / "timeline.jsonl"
    event = {
        "ts": packet["attached_at"],
        "event": "premium_lane_attached",
        "lane_id": lane_id,
        "lane_name": packet["lane_name"],
        "artifact": str(packet_path.relative_to(path)),
        "source": str(source_path.relative_to(path)),
    }
    with timeline.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(event, sort_keys=False) + "\n")

    return {
        "status": "attached",
        "matter_slug": resolved_slug,
        "lane_id": lane_id,
        "lane_name": packet["lane_name"],
        "artifact": str(packet_path),
        "source": str(source_path),
        "timeline_event": "premium_lane_attached",
        "intake_premium_lanes": intake_premium_lanes,
    }


def packet_path_from_args(lane_id: str | None, slug: str | None, path: str | None) -> Path:
    if path:
        return Path(path)
    if not lane_id:
        raise SystemExit("check-packet requires <packet.json> or --lane <lane>")
    _, matter = matter_dir(slug)
    return matter / "workpapers" / f"premium-lane-{lane_id}.json"


def matter_path_for_packet(path: Path) -> Path | None:
    try:
        resolved = path.resolve()
    except FileNotFoundError:
        return None
    for parent in resolved.parents:
        if parent.parent.name == "matters" and parent.parent.parent == GLAW_HOME:
            return parent
    return None


def has_text(value: Any) -> bool:
    return isinstance(value, str) and bool(value.strip())


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def rendered_template_path(matter_path: Path, lane_id: str, idx: int, item_name: str) -> Path:
    return matter_path / "drafts" / f"premium-lane-{lane_id}" / f"{idx:02d}-{item_slug(item_name)}.md"


def rendered_template_manifest(path: Path, packet: dict[str, Any]) -> list[dict[str, Any]]:
    rows: list[dict[str, Any]] = []
    matter_path = matter_path_for_packet(path)
    lane_id = str(packet.get("lane_id", ""))
    required = packet.get("required_packet", [])
    if not matter_path or not isinstance(required, list):
        return rows
    for idx, row in enumerate(required, start=1):
        if not isinstance(row, dict):
            continue
        item_name = str(row.get("item", ""))
        template = rendered_template_path(matter_path, lane_id, idx, item_name)
        if not template.is_file():
            continue
        rows.append({
            "item": item_name,
            "path": str(template.relative_to(matter_path)),
            "bytes": template.stat().st_size,
            "sha256": sha256_file(template),
        })
    return rows


def rendered_template_failures(path: Path, packet: dict[str, Any]) -> list[dict[str, str]]:
    failures: list[dict[str, str]] = []
    matter_path = matter_path_for_packet(path)
    lane_id = str(packet.get("lane_id", ""))
    required = packet.get("required_packet", [])
    if not matter_path:
        failures.append({"id": "rendered_templates", "detail": "packet is not inside a GLAW matter; rendered templates cannot be verified"})
        return failures
    if not isinstance(required, list):
        return failures
    required_terms = ("Owner:", "Report voice:", "Findings:", "Evidence:", "Red flags:", "Sign-off conditions:", "## UPL / Human Authority Footer")
    for idx, row in enumerate(required, start=1):
        if not isinstance(row, dict):
            continue
        item_name = str(row.get("item", ""))
        template = rendered_template_path(matter_path, lane_id, idx, item_name)
        rel = str(template.relative_to(matter_path))
        if not template.is_file():
            failures.append({"id": "rendered_template_missing", "detail": f"missing rendered packet template: {rel}"})
            continue
        text = template.read_text(encoding="utf-8", errors="replace")
        missing_terms = [term for term in required_terms if term not in text]
        if missing_terms:
            failures.append({"id": "rendered_template_quality", "detail": f"{rel} missing: {', '.join(missing_terms)}"})
        if lane_id and f"Lane ID: {lane_id}" not in text:
            failures.append({"id": "rendered_template_lane", "detail": f"{rel} missing lane scope"})
        if item_name and item_name not in text:
            failures.append({"id": "rendered_template_item", "detail": f"{rel} missing packet item label"})
        placeholders = sorted(set(UNRESOLVED_PLACEHOLDER_RE.findall(text)))
        if placeholders or "DRAFT CONTENT TO BE COMPLETED" in text:
            failures.append({"id": "rendered_template_placeholder", "detail": f"{rel} contains unresolved placeholder text"})
        if UNRESOLVED_REVIEW_RE.search(text):
            failures.append({"id": "rendered_template_review_marker", "detail": f"{rel} contains unresolved REVIEW marker"})
    return failures


def check_packet(path: Path) -> dict[str, Any]:
    failures: list[dict[str, str]] = []
    try:
        packet = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        return {"status": "fail", "packet": str(path), "failures": [{"id": "load", "detail": str(exc)}]}
    if not isinstance(packet, dict):
        return {"status": "fail", "packet": str(path), "failures": [{"id": "shape", "detail": "packet must be a JSON object"}]}

    for field in ("matter", "lane_id", "lane_name", "lead_seats", "workstreams", "phase_playbook", "required_packet", "required_lane_packet", "adversarial_reviewers", "docket_items", "hard_no_go", "gates", "authority"):
        if field not in packet:
            failures.append({"id": "packet_field", "detail": f"missing {field}"})

    current_manifest_sha = manifest_sha256()
    if packet.get("manifest_source") != str(MANIFEST.relative_to(ROOT)):
        failures.append({"id": "manifest_freshness", "detail": f"packet missing current manifest source {MANIFEST.relative_to(ROOT)}"})
    if packet.get("manifest_sha256") != current_manifest_sha:
        failures.append({"id": "manifest_stale", "detail": f"premium lane packet was scaffolded from stale manifest digest; reattach or scaffold from {MANIFEST.relative_to(ROOT)}"})

    for field in ("lead_seats", "workstreams", "phase_playbook", "required_packet", "required_lane_packet", "adversarial_reviewers", "docket_items", "hard_no_go", "gates"):
        if field in packet and not isinstance(packet.get(field), list):
            failures.append({"id": "packet_shape", "detail": f"{field} must be a list"})
    for field in OPTIONAL_CHECKLISTS:
        if field in packet and not isinstance(packet.get(field), list):
            failures.append({"id": "packet_shape", "detail": f"{field} must be a list"})

    for idx, row in enumerate(packet.get("workstreams", []) if isinstance(packet.get("workstreams"), list) else [], start=1):
        if not isinstance(row, dict):
            failures.append({"id": "workstream_shape", "detail": f"workstreams[{idx}] must be an object"})
            continue
        if not has_text(row.get("owner")):
            failures.append({"id": "workstream_owner", "detail": f"workstreams[{idx}] lacks owner"})
        if row.get("status") not in {"complete", "blocked_with_owner"}:
            failures.append({"id": "workstream_status", "detail": f"workstreams[{idx}] status must be complete|blocked_with_owner"})

    for idx, row in enumerate(packet.get("phase_playbook", []) if isinstance(packet.get("phase_playbook"), list) else [], start=1):
        if not isinstance(row, dict):
            failures.append({"id": "phase_shape", "detail": f"phase_playbook[{idx}] must be an object"})
            continue
        if not has_text(row.get("owner")):
            failures.append({"id": "phase_owner", "detail": f"phase_playbook[{idx}] lacks owner"})
        if row.get("status") not in {"complete", "blocked_with_owner"}:
            failures.append({"id": "phase_status", "detail": f"phase_playbook[{idx}] status must be complete|blocked_with_owner"})

    lane_packet_items = {row.get("item") for row in packet.get("required_lane_packet", []) if isinstance(row, dict)}
    required_items = {row.get("item") for row in packet.get("required_packet", []) if isinstance(row, dict)}
    missing_lane_items = sorted(str(item) for item in lane_packet_items - required_items if item)
    if missing_lane_items:
        failures.append({"id": "required_lane_packet", "detail": "required_packet omits lane-specific items: " + ", ".join(missing_lane_items)})

    for idx, row in enumerate(packet.get("required_packet", []) if isinstance(packet.get("required_packet"), list) else [], start=1):
        if not isinstance(row, dict):
            failures.append({"id": "required_packet_shape", "detail": f"required_packet[{idx}] must be an object"})
            continue
        if not has_text(row.get("owner")):
            failures.append({"id": "required_packet_owner", "detail": f"required_packet[{idx}] lacks owner"})
        if row.get("status") not in {"complete", "not_applicable_with_rationale"}:
            failures.append({"id": "required_packet_status", "detail": f"required_packet[{idx}] status must be complete|not_applicable_with_rationale"})
        if row.get("status") == "not_applicable_with_rationale" and not has_text(row.get("rationale")):
            failures.append({"id": "required_packet_rationale", "detail": f"required_packet[{idx}] lacks not-applicable rationale"})

    for field, (key, terms, _proof) in OPTIONAL_CHECKLISTS.items():
        if field not in packet:
            continue
        rows = packet.get(field, []) if isinstance(packet.get(field), list) else []
        row_text = "\n".join(str(row.get(key, "")) for row in rows if isinstance(row, dict))
        for term in terms:
            if term not in row_text:
                failures.append({"id": field, "detail": f"missing required item: {term}"})
        for idx, row in enumerate(rows, start=1):
            if not isinstance(row, dict):
                failures.append({"id": f"{field}_shape", "detail": f"{field}[{idx}] must be an object"})
                continue
            if not has_text(row.get("owner")):
                failures.append({"id": f"{field}_owner", "detail": f"{field}[{idx}] lacks owner"})
            if row.get("status") not in {"complete", "not_applicable_with_rationale"}:
                failures.append({"id": f"{field}_status", "detail": f"{field}[{idx}] status must be complete|not_applicable_with_rationale"})
            if row.get("status") == "not_applicable_with_rationale" and not has_text(row.get("rationale")):
                failures.append({"id": f"{field}_rationale", "detail": f"{field}[{idx}] lacks not-applicable rationale"})

    for idx, row in enumerate(packet.get("adversarial_reviewers", []) if isinstance(packet.get("adversarial_reviewers"), list) else [], start=1):
        if not isinstance(row, dict):
            failures.append({"id": "reviewer_shape", "detail": f"adversarial_reviewers[{idx}] must be an object"})
            continue
        if row.get("status") != "survived":
            failures.append({"id": "reviewer_status", "detail": f"adversarial_reviewers[{idx}] must be survived"})

    for idx, row in enumerate(packet.get("docket_items", []) if isinstance(packet.get("docket_items"), list) else [], start=1):
        if not isinstance(row, dict):
            failures.append({"id": "docket_shape", "detail": f"docket_items[{idx}] must be an object"})
            continue
        if not has_text(row.get("owner")):
            failures.append({"id": "docket_owner", "detail": f"docket_items[{idx}] lacks owner"})
        if not has_text(row.get("due")):
            failures.append({"id": "docket_due", "detail": f"docket_items[{idx}] lacks due date"})
        if not has_text(row.get("source")) or "SRC-" not in str(row.get("source")):
            failures.append({"id": "docket_source", "detail": f"docket_items[{idx}] lacks SRC source"})

    gates = set(packet.get("gates", []) if isinstance(packet.get("gates"), list) else [])
    for gate in ("structured intake complete", "conflicts cleared", "citations verified", "adversarial RED to BLUE", "Chief/Council approved", "UPL footer", "docket gate complete"):
        if gate not in gates:
            failures.append({"id": "gate", "detail": f"missing gate: {gate}"})
    if not any("without human authority" in str(item) for item in packet.get("hard_no_go", []) if isinstance(packet.get("hard_no_go"), list)):
        failures.append({"id": "hard_no_go", "detail": "missing human-authority no-go"})
    if "legal advice" not in str(packet.get("authority", "")).lower() and "licensed counsel" not in str(packet.get("authority", "")).lower():
        failures.append({"id": "authority", "detail": "authority disclaimer missing licensed-counsel/legal-advice language"})
    failures.extend(rendered_template_failures(path, packet))
    rendered_templates = rendered_template_manifest(path, packet)

    return {
        "status": "fail" if failures else "pass",
        "packet": str(path),
        "lane_id": packet.get("lane_id", ""),
        "rendered_templates": rendered_templates,
        "failures": failures,
        "authority": "packet readiness check is a source-only gate; it does not approve filing or replace Chief/Council approval",
    }


def complete_packet(
    path: Path,
    owner: str,
    docket_owner: str,
    due: str,
    source: str,
    reviewer_status: str,
    as_of: str | None = None,
) -> dict[str, Any]:
    if not has_text(owner):
        raise SystemExit("--owner is required")
    docket_owner = docket_owner or owner
    require_iso_date(due, "--due")
    if not has_text(source) or "SRC-" not in source:
        raise SystemExit("--source must include an SRC- source reference")
    if reviewer_status != "survived":
        raise SystemExit("--reviewer-status currently supports only survived")

    try:
        packet = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise SystemExit(f"cannot load packet: {exc}") from exc
    if not isinstance(packet, dict):
        raise SystemExit("packet must be a JSON object")

    stamp = as_of or now()
    for row in packet.get("workstreams", []):
        if isinstance(row, dict):
            row["owner"] = row.get("owner") or owner
            row["status"] = "complete"
            row["completed_at"] = row.get("completed_at") or stamp
    for row in packet.get("phase_playbook", []):
        if isinstance(row, dict):
            row["owner"] = row.get("owner") or owner
            row["status"] = "complete"
            row["completed_at"] = row.get("completed_at") or stamp
    for row in packet.get("required_packet", []):
        if isinstance(row, dict):
            row["owner"] = row.get("owner") or owner
            row["status"] = "complete"
            row["completed_at"] = row.get("completed_at") or stamp
    for row in packet.get("required_lane_packet", []):
        if isinstance(row, dict):
            row["owner"] = row.get("owner") or owner
            row["status"] = "complete"
            row["completed_at"] = row.get("completed_at") or stamp
    for field in OPTIONAL_CHECKLISTS:
        for row in packet.get(field, []):
            if isinstance(row, dict):
                row["owner"] = row.get("owner") or owner
                row["status"] = "complete"
                row["completed_at"] = row.get("completed_at") or stamp
    for row in packet.get("adversarial_reviewers", []):
        if isinstance(row, dict):
            row["status"] = reviewer_status
            row["reviewed_at"] = row.get("reviewed_at") or stamp
    for row in packet.get("docket_items", []):
        if isinstance(row, dict):
            row["owner"] = row.get("owner") or docket_owner
            row["due"] = row.get("due") or due
            row["source"] = row.get("source") if has_text(row.get("source")) and "SRC-" in str(row.get("source")) else source

    packet["completed_at"] = stamp
    packet["completed_by"] = owner
    packet["completion_authority"] = "source-only lane packet completion; this is not a filing, signature, payment, legal opinion, or Chief/Council approval"
    path.write_text(json.dumps(packet, indent=2, sort_keys=False) + "\n", encoding="utf-8")

    report = check_packet(path)
    matter_path = matter_path_for_packet(path)
    timeline_event = ""
    if matter_path:
        timeline_event = "premium_lane_packet_completed"
        event = {
            "ts": stamp,
            "event": timeline_event,
            "lane_id": packet.get("lane_id", ""),
            "lane_name": packet.get("lane_name", ""),
            "artifact": str(path.resolve().relative_to(matter_path.resolve())),
            "source": source,
            "status": report["status"],
        }
        with (matter_path / "timeline.jsonl").open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(event, sort_keys=False) + "\n")

    return {
        "status": report["status"],
        "packet": str(path),
        "lane_id": packet.get("lane_id", ""),
        "completed_at": stamp,
        "completed_by": owner,
        "timeline_event": timeline_event,
        "failures": report.get("failures", []),
        "authority": packet["completion_authority"],
    }


def docket_packet(path: Path) -> dict[str, Any]:
    report = check_packet(path)
    if report["status"] != "pass":
        return {
            "status": "fail",
            "packet": str(path),
            "docketed": [],
            "skipped": [],
            "failures": report.get("failures", []),
            "authority": "docket materialization refused because the premium lane packet is incomplete",
        }
    try:
        packet = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        return {"status": "fail", "packet": str(path), "failures": [{"id": "load", "detail": str(exc)}]}
    matter_path = matter_path_for_packet(path)
    if not matter_path:
        return {
            "status": "fail",
            "packet": str(path),
            "docketed": [],
            "skipped": [],
            "failures": [{"id": "matter_path", "detail": "packet is not inside a GLAW matter workpapers directory"}],
            "authority": "docket materialization writes only to matter-local docket.jsonl",
        }
    docket_path = matter_path / "docket.jsonl"
    existing = docket_path.read_text(encoding="utf-8", errors="replace") if docket_path.exists() else ""
    stamp = now()
    docketed: list[dict[str, str]] = []
    skipped: list[dict[str, str]] = []
    with docket_path.open("a", encoding="utf-8") as fh:
        for idx, row in enumerate(packet.get("docket_items", []), start=1):
            if not isinstance(row, dict):
                continue
            due = require_iso_date(str(row.get("due", "")), f"docket_items[{idx}].due")
            desc = f"Premium lane {packet.get('lane_id', '')}: {row.get('item', '')}"
            owner = str(row.get("owner", "")).strip()
            source = str(row.get("source", "")).strip()
            key = f'"due":"{escape_jsonl_text(due)}","desc":"{escape_jsonl_text(desc)}"'
            if key in existing:
                skipped.append({"due": due, "desc": desc, "reason": "already_docketed"})
                continue
            entry = {
                "ts": stamp,
                "due": due,
                "desc": desc,
                "status": "open",
                "owner": owner,
                "source": source,
                "lane_id": str(packet.get("lane_id", "")),
                "premium_lane_artifact": str(path.resolve().relative_to(matter_path.resolve())),
            }
            fh.write(json.dumps(entry, sort_keys=False, separators=(",", ":")) + "\n")
            docketed.append({"due": due, "desc": desc, "owner": owner, "source": source})
            existing += key

    timeline_event = "premium_lane_docketed"
    event = {
        "ts": stamp,
        "event": timeline_event,
        "lane_id": packet.get("lane_id", ""),
        "lane_name": packet.get("lane_name", ""),
        "artifact": str(path.resolve().relative_to(matter_path.resolve())),
        "docketed_count": len(docketed),
        "skipped_count": len(skipped),
    }
    with (matter_path / "timeline.jsonl").open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(event, sort_keys=False) + "\n")

    return {
        "status": "pass",
        "packet": str(path),
        "lane_id": packet.get("lane_id", ""),
        "docketed": docketed,
        "skipped": skipped,
        "timeline_event": timeline_event,
        "authority": "source-only docket materialization; it does not file, sign, transmit, pay, or approve legal advice",
    }


def packet_docketed(matter_path: Path, packet_path: Path, lane_id: str) -> bool:
    docket_path = matter_path / "docket.jsonl"
    if not docket_path.is_file():
        return False
    try:
        artifact = str(packet_path.resolve().relative_to(matter_path.resolve()))
    except ValueError:
        artifact = packet_path.name
    for line in docket_path.read_text(encoding="utf-8", errors="replace").splitlines():
        if not line.strip():
            continue
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if row.get("lane_id") == lane_id and row.get("premium_lane_artifact") == artifact:
            return True
    return False


def next_status_command(slug: str, lane_id: str, failures: list[dict[str, Any]], docketed: bool) -> str:
    ids = {str(row.get("id", "")) for row in failures if isinstance(row, dict)}
    if "manifest_stale" in ids or "manifest_freshness" in ids:
        return f"bin/glaw-premium-lanes attach {lane_id} --matter-slug {slug}"
    rendered_ids = {item for item in ids if item.startswith("rendered_template_")}
    docket_ids = {"docket_materialized"}
    metadata_ids = ids - rendered_ids - docket_ids
    if metadata_ids:
        return f"bin/glaw-premium-lanes complete --lane {lane_id} --matter-slug {slug} --owner \"named lead\" --docket-owner \"docket owner\" --due YYYY-MM-DD --source \"SRC-0001 basis\""
    if rendered_ids:
        return f"bin/glaw-premium-lanes render-packet --lane {lane_id} --matter-slug {slug} --owner \"named lead\" --source \"SRC-0001 basis\""
    if ids & docket_ids:
        return f"bin/glaw-premium-lanes docket --lane {lane_id} --matter-slug {slug}"
    if not docketed:
        return f"bin/glaw-premium-lanes docket --lane {lane_id} --matter-slug {slug}"
    return f"bin/glaw-final-packet build --profile auto"


def matter_status(slug: str | None) -> dict[str, Any]:
    resolved_slug, matter_path = matter_dir(slug)
    workpapers = matter_path / "workpapers"
    paths = sorted(workpapers.glob("premium-lane-*.json")) if workpapers.is_dir() else []
    if not paths:
        return {
            "status": "fail",
            "matter_slug": resolved_slug,
            "lane_count": 0,
            "lanes": [],
            "failures": [{"id": "premium_lane_missing", "detail": "no premium lane packets are attached to this matter"}],
            "action_plan": [{
                "id": "premium_lane_missing",
                "owner": "GLAW Managing Partner",
                "next_command": "bin/glaw-premium-lanes attach <lane> --matter-slug " + resolved_slug,
                "required_fix": "attach at least one required premium lane packet for Fortune 500, tax-system, founder/unicorn, investor, or UHNW work",
            }],
            "authority": "source-only matter status; it does not approve filing or replace Chief/Council approval",
        }

    lanes: list[dict[str, Any]] = []
    failures: list[dict[str, Any]] = []
    action_plan: list[dict[str, Any]] = []
    for path in paths:
        try:
            packet = json.loads(path.read_text(encoding="utf-8"))
        except Exception as exc:
            lane_id = path.stem.removeprefix("premium-lane-")
            packet_failures = [{"id": "load", "detail": str(exc)}]
            docketed = False
            check_status = "fail"
            rendered_templates: list[dict[str, Any]] = []
            lane_name = lane_id
        else:
            lane_id = str(packet.get("lane_id") or path.stem.removeprefix("premium-lane-"))
            lane_name = str(packet.get("lane_name") or lane_id)
            check = check_packet(path)
            packet_failures = list(check.get("failures", []))
            check_status = str(check.get("status", "fail"))
            rendered_templates = list(check.get("rendered_templates", []))
            docketed = packet_docketed(matter_path, path, lane_id)
        lane_failures = list(packet_failures)
        if check_status == "pass" and not docketed:
            lane_failures.append({"id": "docket_materialized", "detail": f"{lane_id} packet passes check-packet but recurring obligations are not materialized in docket.jsonl"})
        lane_status = "pass" if check_status == "pass" and docketed else "fail"
        next_command = next_status_command(resolved_slug, lane_id, lane_failures, docketed)
        row = {
            "lane_id": lane_id,
            "lane_name": lane_name,
            "status": lane_status,
            "packet": str(path),
            "check_packet_status": check_status,
            "docketed": docketed,
            "rendered_template_count": len(rendered_templates),
            "failure_count": len(lane_failures),
            "failures": lane_failures,
            "next_command": next_command,
        }
        lanes.append(row)
        if lane_failures:
            failures.extend({"lane_id": lane_id, **failure} for failure in lane_failures if isinstance(failure, dict))
            action_plan.append({
                "id": lane_failures[0].get("id", "premium_lane_packet") if isinstance(lane_failures[0], dict) else "premium_lane_packet",
                "lane_id": lane_id,
                "owner": "premium lane lead",
                "next_command": next_command,
                "required_fix": lane_failures[0].get("detail", "complete the premium lane packet") if isinstance(lane_failures[0], dict) else "complete the premium lane packet",
            })

    return {
        "status": "pass" if lanes and all(row["status"] == "pass" for row in lanes) else "fail",
        "matter_slug": resolved_slug,
        "lane_count": len(lanes),
        "lanes": lanes,
        "failures": failures,
        "action_plan": action_plan,
        "authority": "source-only matter status; premium lane readiness still requires final-packet, Chief/Council, UPL, citation, adversarial, and docket gates",
    }


def lane_template_body(packet: dict[str, Any], item: dict[str, Any], source: str, owner: str) -> str:
    lane_id = packet.get("lane_id", "")
    item_name = item.get("item", "")
    workstreams = "\n".join(f"- {row.get('name', '')} | owner {row.get('owner', owner)}" for row in packet.get("workstreams", []) if isinstance(row, dict))
    phases = "\n".join(f"- {row.get('phase', '')} | owner {row.get('owner', owner)}" for row in packet.get("phase_playbook", []) if isinstance(row, dict))
    lane_packet = "\n".join(f"- {row.get('item', '')} | owner {row.get('owner', owner)}" for row in packet.get("required_lane_packet", []) if isinstance(row, dict))
    creative_planning = "\n".join(f"- {row.get('item', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("creative_planning_required", []) if isinstance(row, dict))
    trust_taxonomy = "\n".join(f"- {row.get('type', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("trust_taxonomy_required", []) if isinstance(row, dict))
    schwab_topics = "\n".join(f"- {row.get('topic', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("schwab_trust_topic_required", []) if isinstance(row, dict))
    entity_topology = "\n".join(f"- {row.get('item', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("entity_topology_required", []) if isinstance(row, dict))
    source_ingest = "\n".join(f"- {row.get('item', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("source_ingest_required", []) if isinstance(row, dict))
    capital_raise = "\n".join(f"- {row.get('item', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("capital_raise_required", []) if isinstance(row, dict))
    investor = "\n".join(f"- {row.get('item', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("investor_required", []) if isinstance(row, dict))
    qsbs = "\n".join(f"- {row.get('item', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("qsbs_required", []) if isinstance(row, dict))
    tax_credit = "\n".join(f"- {row.get('item', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("tax_credit_required", []) if isinstance(row, dict))
    tax_engine = "\n".join(f"- {row.get('item', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("tax_engine_required", []) if isinstance(row, dict))
    enterprise = "\n".join(f"- {row.get('item', '')} | owner {row.get('owner', owner)} | status {row.get('status', 'not_started')}" for row in packet.get("enterprise_required", []) if isinstance(row, dict))
    reviewers = "\n".join(f"- {row.get('reviewer', '')}: {row.get('status', 'not_started')}" for row in packet.get("adversarial_reviewers", []) if isinstance(row, dict))
    docket = "\n".join(f"- {row.get('due', '')}: {row.get('item', '')} ({row.get('owner', owner)}; {row.get('source', source)})" for row in packet.get("docket_items", []) if isinstance(row, dict))
    no_go = "\n".join(f"- {row}" for row in packet.get("hard_no_go", []))
    return f"""# {packet.get('lane_name', 'Premium Lane')} - {item_name}

Owner: {item.get('owner') or owner}
Report voice: GLAW premium client lane work-product for licensed attorney/CPA/local-counsel review.
Findings: Draft the {item_name} for {packet.get('matter', 'the matter')} under the {packet.get('lane_name', lane_id)} lane.
Evidence: {source} premium lane packet, matter evidence, current law/figures, financial data, and client-provided assumptions must be verified before reliance.
Red flags: Do not rely on this draft if any hard no-go item, stale source, unresolved reviewer attack, missing owner, or undocketed deadline remains.
Sign-off conditions: Licensed attorney/CPA/local counsel, Chief/Council, citation, adversarial, UPL, final-packet, and docket gates must clear before external use.

## Lane Scope

- Lane ID: {lane_id}
- Matter: {packet.get('matter', '')}
- Packet item: {item_name}
- Status: {item.get('status', 'not_started')}

## Seat Ownership

{workstreams or '- Pending seat ownership.'}

## Phase Playbook

{phases or '- Pending lane phase playbook.'}

## Lane-Specific Packet Items

{lane_packet or '- Pending lane-specific packet items.'}

## Creative Planning Required

{creative_planning or '- No lane-specific Creative Planning integrated advisory benchmark checklist required.'}

## Trust Taxonomy Required

{trust_taxonomy or '- No lane-specific trust taxonomy required.'}

## Schwab Trust Topic Required

{schwab_topics or '- No lane-specific Schwab trust topic-index checklist required.'}

## Entity Topology Required

{entity_topology or '- No lane-specific entity topology checklist required.'}

## Source Ingest Required

{source_ingest or '- No lane-specific local source-ingest checklist required.'}

## Capital Raise Required

{capital_raise or '- No lane-specific capital raise checklist required.'}

## Investor Required

{investor or '- No lane-specific investor-purpose checklist required.'}

## QSBS Required

{qsbs or '- No lane-specific QSBS certificate checklist required.'}

## Tax Credit Required

{tax_credit or '- No lane-specific tax-credit substantiation checklist required.'}

## Tax Engine Required

{tax_engine or '- No lane-specific tax engine checklist required.'}

## Enterprise Required

{enterprise or '- No lane-specific enterprise checklist required.'}

## Required Analysis

1. State the decision or client action requested.
2. Identify the governing entity, tax, securities, accounting, investor, trust, or board rule.
3. Tie every conclusion to source evidence and current figures.
4. Identify implementation owner, signer, filing party, advisor, deadline, and dependency.
5. For every premium lane, classify every Creative Planning integrated advisory benchmark item as complete, rejected, or not applicable with source date, lane routing, owner, and rationale before saying the packet reflects a whole-client advisory flow.
6. For UHNW/founder wealth planning, classify every trust type required by `trust-taxonomy-routing.md` as selected, rejected, or not applicable with rationale.
7. For UHNW work, classify every Schwab trust topic-index item as complete, rejected, or not applicable with rationale and source date before saying the trust lane reflects current public-market trust planning questions.
8. For founder/UHNW topology work, classify every dynasty trust, investment LLC, direct-ownership carve-out, tax, securities, creditor, fiduciary, and funding item as complete, rejected, or not applicable with rationale before moving any asset.
9. For source-ingest work, classify every local PDF, external authority refresh, extraction artifact, routing owner, no-go source, and output traceability row as complete, rejected, or not applicable before relying on source-ingested material.
10. For founder/investor fundraising, classify every capital-raise item as complete, rejected, or not applicable with rationale before investor-facing use.
11. For investor-purpose work, classify every investor onboarding, tax, reporting, communications, transfer, and complaint-control item as complete, rejected, or not applicable with rationale before investor-facing use.
12. For QSBS work, classify every issuer, shareholder, certificate, annual checklist, redemption, gross-assets, active-business, section 1045, section 1202, ownership, and M&A preservation item as complete, rejected, or not applicable with rationale before any QSBS statement is used.
13. For tax-credit work, classify every credit eligibility, substantiation, computation, form, return-position, transferability, recapture, state/local, ASC 740, and adversarial item as complete, rejected, or not applicable with rationale before claiming, selling, transferring, reporting, or modeling any credit.
14. For tax-system work, classify every tax engine item as complete, rejected, or not applicable with rationale before any return position, filing packet, investor tax statement, or controversy recommendation is used.
15. For enterprise work, classify every enterprise governance/reporting/control item as complete, rejected, or not applicable with rationale before board, investor, auditor, regulator, or public-company use.
16. State open questions and facts that would change the recommendation.

## Regulator/Opponent Review

{reviewers or '- Pending adversarial review.'}

## Docket Handoff

{docket or '- Pending docket rows.'}

## Hard No-Go Screen

{no_go}

## Workpaper Build Plan

- Decision memo: state the recommended action, alternatives rejected, and decision owner.
- Source tie-out: cite each controlling document, source evidence row, current figure, and open assumption.
- Tax/legal/security/accounting analysis: route each conclusion to the owning GLAW seat and governing rule.
- Implementation lane: identify signer, filing party, advisor, jurisdiction, deadline, and handoff artifact.
- Adversarial response: answer the regulator, investor counsel, IRS, SEC, creditor, trustee, auditor, or opposing-counsel attack that applies.
- Sign-off record: name the licensed reviewer conditions that remain before external use.

## UPL / Human Authority Footer

Attorney work-product draft for review by licensed counsel/CPA/local counsel. This file does not give legal, tax, accounting, investment, or fiduciary advice; does not create an attorney-client relationship by itself; and does not authorize any filing, signature, service, payment, transmission, securities offering, tax return position, trust transfer, or other binding act without express human authority.
"""


def render_packet_templates(path: Path, owner: str, source: str) -> dict[str, Any]:
    if not has_text(owner):
        raise SystemExit("--owner is required")
    if not has_text(source) or "SRC-" not in source:
        raise SystemExit("--source must include an SRC- source reference")
    try:
        packet = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        return {"status": "fail", "packet": str(path), "failures": [{"id": "load", "detail": str(exc)}]}
    if not isinstance(packet, dict):
        return {"status": "fail", "packet": str(path), "failures": [{"id": "shape", "detail": "packet must be a JSON object"}]}
    matter_path = matter_path_for_packet(path)
    if not matter_path:
        return {
            "status": "fail",
            "packet": str(path),
            "failures": [{"id": "matter_path", "detail": "packet is not inside a GLAW matter workpapers directory"}],
        }
    lane_id = str(packet.get("lane_id", "premium-lane"))
    out_dir = matter_path / "drafts" / f"premium-lane-{lane_id}"
    out_dir.mkdir(parents=True, exist_ok=True)
    rendered: list[dict[str, str]] = []
    for idx, item in enumerate(packet.get("required_packet", []), start=1):
        if not isinstance(item, dict):
            continue
        filename = f"{idx:02d}-{item_slug(str(item.get('item', 'packet item')))}.md"
        out = out_dir / filename
        out.write_text(lane_template_body(packet, item, source, owner), encoding="utf-8")
        rendered.append({"item": str(item.get("item", "")), "path": str(out.relative_to(matter_path))})

    stamp = now()
    event = {
        "ts": stamp,
        "event": "premium_lane_templates_rendered",
        "lane_id": lane_id,
        "lane_name": packet.get("lane_name", ""),
        "artifact": str(path.resolve().relative_to(matter_path.resolve())),
        "rendered_count": len(rendered),
        "source": source,
    }
    with (matter_path / "timeline.jsonl").open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(event, sort_keys=False) + "\n")

    return {
        "status": "pass",
        "packet": str(path),
        "lane_id": lane_id,
        "rendered": rendered,
        "timeline_event": "premium_lane_templates_rendered",
        "authority": "source-only draft template rendering; attorney/CPA/local-counsel review and human authority are required before external use",
    }


def emit(value: Any, as_json: bool) -> None:
    if as_json:
        print(json.dumps(value, indent=2, sort_keys=False))
    elif isinstance(value, dict) and "status" in value:
        print(f"PREMIUM LANES: {value['status']}")
        print(f"  lanes: {value.get('lane_count')}")
        for failure in value.get("failures", []):
            print(f"  fail: {failure.get('detail')}")
    else:
        print(json.dumps(value, indent=2, sort_keys=False))


def emit_playbook(plan: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(plan, indent=2, sort_keys=False))
    else:
        print(playbook_markdown(plan))


def emit_trust_taxonomy(report: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(report, indent=2, sort_keys=False))
        return
    print(f"TRUST TAXONOMY: {report.get('status')}")
    print(f"  source: {report.get('source')}")
    print(f"  trust_types: {report.get('trust_type_count')}")
    for row in report.get("trust_types", []):
        print(f"  - {row.get('type')}: {row.get('tax_posture')} -> {', '.join(row.get('routing', []))}")
    for failure in report.get("failures", []):
        print(f"  fail: {failure.get('detail')}")


def emit_founder_blueprint(report: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(report, indent=2, sort_keys=False))
        return
    print(founder_blueprint_markdown(report))


def emit_tax_engine_blueprint(report: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(report, indent=2, sort_keys=False))
        return
    print(tax_engine_blueprint_markdown(report))


def emit_enterprise_blueprint(report: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(report, indent=2, sort_keys=False))
        return
    print(enterprise_blueprint_markdown(report))


def emit_firm_blueprint(report: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(report, indent=2, sort_keys=False))
        return
    print(firm_blueprint_markdown(report))


def emit_source_ingest(report: dict[str, Any], as_json: bool) -> None:
    if as_json:
        print(json.dumps(report, indent=2, sort_keys=False))
        return
    print(f"LOCAL SOURCE INGEST: {report.get('status')}")
    print(f"  sources: {report.get('source_count')} / {report.get('required_source_count')}")
    print(f"  extractor: {report.get('extractor') or 'missing'}")
    print(f"  extracted chars: {report.get('extracted_char_count')}")
    for row in report.get("sources", []):
        print(f"  - {row.get('id')}: {row.get('extraction_status')} {row.get('sha256', '')[:12]} {row.get('path')}")
    for failure in report.get("failures", []):
        print(f"  fail: {failure.get('detail')}")


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="glaw-premium-lanes")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    show = sub.add_parser("show")
    show.add_argument("lane")
    show.add_argument("--json", action="store_true")
    pb = sub.add_parser("playbook")
    pb.add_argument("lane")
    pb.add_argument("--matter", default="premium-lane-matter")
    pb.add_argument("--json", action="store_true")
    scaf = sub.add_parser("scaffold")
    scaf.add_argument("lane")
    scaf.add_argument("--matter", default="premium-lane-matter")
    scaf.add_argument("--json", action="store_true")
    att = sub.add_parser("attach")
    att.add_argument("lane")
    att.add_argument("--matter-slug", default="")
    att.add_argument("--matter", default="")
    att.add_argument("--json", action="store_true")
    chk = sub.add_parser("check-packet")
    chk.add_argument("packet", nargs="?")
    chk.add_argument("--lane", default="")
    chk.add_argument("--matter-slug", default="")
    chk.add_argument("--json", action="store_true")
    comp = sub.add_parser("complete")
    comp.add_argument("packet", nargs="?")
    comp.add_argument("--lane", default="")
    comp.add_argument("--matter-slug", default="")
    comp.add_argument("--owner", required=True)
    comp.add_argument("--docket-owner", default="")
    comp.add_argument("--due", required=True)
    comp.add_argument("--source", required=True)
    comp.add_argument("--reviewer-status", default="survived")
    comp.add_argument("--json", action="store_true")
    dock = sub.add_parser("docket")
    dock.add_argument("packet", nargs="?")
    dock.add_argument("--lane", default="")
    dock.add_argument("--matter-slug", default="")
    dock.add_argument("--json", action="store_true")
    status = sub.add_parser("status")
    status.add_argument("--matter-slug", default="")
    status.add_argument("--json", action="store_true")
    audit = sub.add_parser("audit-objective")
    audit.add_argument("--json", action="store_true")
    trust = sub.add_parser("trust-taxonomy")
    trust.add_argument("--json", action="store_true")
    src_ingest = sub.add_parser("source-ingest-audit")
    src_ingest.add_argument("--json", action="store_true")
    src_mat = sub.add_parser("materialize-source-ingest")
    src_mat.add_argument("--matter-slug", default="")
    src_mat.add_argument("--json", action="store_true")
    founder = sub.add_parser("founder-blueprint")
    founder.add_argument("--matter", default="founder-capital-shelter-matter")
    founder.add_argument("--json", action="store_true")
    tax_bp = sub.add_parser("tax-engine-blueprint")
    tax_bp.add_argument("--matter", default="tax-system-engine-matter")
    tax_bp.add_argument("--json", action="store_true")
    ent_bp = sub.add_parser("enterprise-blueprint")
    ent_bp.add_argument("--matter", default="fortune500-enterprise-matter")
    ent_bp.add_argument("--json", action="store_true")
    firm_bp = sub.add_parser("firm-blueprint")
    firm_bp.add_argument("--matter", default="integrated-glaw-premium-matter")
    firm_bp.add_argument("--json", action="store_true")
    rend = sub.add_parser("render-packet")
    rend.add_argument("packet", nargs="?")
    rend.add_argument("--lane", default="")
    rend.add_argument("--matter-slug", default="")
    rend.add_argument("--owner", required=True)
    rend.add_argument("--source", required=True)
    rend.add_argument("--json", action="store_true")
    val = sub.add_parser("validate")
    val.add_argument("--json", action="store_true")
    args = ap.parse_args(argv)
    data = load_manifest()
    if args.cmd == "list":
        for lane_id, lane in sorted(data.get("lanes", {}).items()):
            print(f"{lane_id}\t{lane.get('name', '')}")
        return 0
    if args.cmd == "show":
        emit({"lane_id": args.lane, **lane_or_fail(data, args.lane)}, args.json)
        return 0
    if args.cmd == "playbook":
        emit_playbook(playbook(data, args.lane, args.matter), args.json)
        return 0
    if args.cmd == "scaffold":
        emit(scaffold(data, args.lane, args.matter), args.json)
        return 0
    if args.cmd == "attach":
        emit(attach(data, args.lane, args.matter_slug or None, args.matter or None), args.json)
        return 0
    if args.cmd == "check-packet":
        report = check_packet(packet_path_from_args(args.lane or None, args.matter_slug or None, args.packet))
        emit(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "complete":
        report = complete_packet(
            packet_path_from_args(args.lane or None, args.matter_slug or None, args.packet),
            args.owner,
            args.docket_owner or args.owner,
            args.due,
            args.source,
            args.reviewer_status,
        )
        emit(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "docket":
        report = docket_packet(packet_path_from_args(args.lane or None, args.matter_slug or None, args.packet))
        emit(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "status":
        report = matter_status(args.matter_slug or None)
        emit(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "audit-objective":
        report = objective_audit(data)
        emit(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "trust-taxonomy":
        report = trust_taxonomy_report(data)
        emit_trust_taxonomy(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "source-ingest-audit":
        report = local_source_ingest_report(data)
        emit_source_ingest(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "materialize-source-ingest":
        report = materialize_local_source_ingest(data, args.matter_slug or None)
        emit(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "founder-blueprint":
        report = founder_blueprint(data, args.matter)
        emit_founder_blueprint(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "tax-engine-blueprint":
        report = tax_engine_blueprint(data, args.matter)
        emit_tax_engine_blueprint(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "enterprise-blueprint":
        report = enterprise_blueprint(data, args.matter)
        emit_enterprise_blueprint(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "firm-blueprint":
        report = firm_blueprint(data, args.matter)
        emit_firm_blueprint(report, args.json)
        return 0 if report["status"] == "pass" else 1
    if args.cmd == "render-packet":
        report = render_packet_templates(
            packet_path_from_args(args.lane or None, args.matter_slug or None, args.packet),
            args.owner,
            args.source,
        )
        emit(report, args.json)
        return 0 if report["status"] == "pass" else 1
    report = validate_manifest(data)
    emit(report, args.json)
    return 0 if report["status"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
