UNRESOLVED_PLACEHOLDER_RE = re.compile(r"\[(?:[A-Z][A-Z0-9 _./:-]{1,}|VERIFY|TODO|TBD)[^\]]*\]")
UNRESOLVED_REVIEW_RE = re.compile(r"(?:^|\n)REVIEW\s*:", re.IGNORECASE)


def load_manifest() -> dict[str, Any]:
    data = json.loads(MANIFEST.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise ValueError("premium lane manifest must be a JSON object")
    return data


def manifest_sha256() -> str:
    return hashlib.sha256(MANIFEST.read_bytes()).hexdigest()


def shutil_which(name: str) -> str:
    for folder in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(folder) / name
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return ""


def local_source_path(canonical_path: str) -> Path:
    """Resolve a configured portable source root without changing the manifest identity."""
    source_root = os.environ.get("GLAW_PREMIUM_SOURCE_ROOT", "").strip()
    if not source_root:
        return Path(canonical_path)
    desktop_root = Path("/Users/ricardoprieto/Desktop")
    try:
        relative = Path(canonical_path).relative_to(desktop_root)
    except ValueError:
        relative = Path(canonical_path).name
    return Path(source_root).expanduser().resolve() / relative


def local_source_ingest_report(data: dict[str, Any]) -> dict[str, Any]:
    failures: list[dict[str, str]] = []
    rows: list[dict[str, Any]] = []
    source_terms = "\n".join(SOURCE_INGEST_TERMS)
    pdftotext = shutil_which("pdftotext")
    resolved_sources = [
        (spec, local_source_path(str(spec["path"])))
        for spec in LOCAL_SOURCE_INGEST_FILES
    ]
    explicitly_configured = bool(os.environ.get("GLAW_PREMIUM_SOURCE_ROOT", "").strip())
    corpus_configured = explicitly_configured or any(path.is_file() for _, path in resolved_sources)
    for spec, path in resolved_sources:
        canonical_path = str(spec["path"])
        row: dict[str, Any] = {
            "id": spec["id"],
            "path": str(path),
            "lane": spec["lane"],
            "routing": spec["routing"],
            "exists": path.is_file(),
            "size_bytes": 0,
            "sha256": "",
            "extractor": "pdftotext" if pdftotext else "",
            "extraction_status": "missing_source",
            "extracted_chars": 0,
            "extracted_sha256": "",
            "canonical_path": canonical_path,
            "source_ingest_term_present": canonical_path in source_terms,
        }
        if not row["source_ingest_term_present"]:
            failures.append({"id": "source_ingest_term_missing", "detail": f"source-ingest manifest omits local source: {path}"})
        if not path.is_file():
            if corpus_configured:
                failures.append({"id": "local_source_missing", "detail": f"local source missing: {path}"})
            rows.append(row)
            continue
        row["size_bytes"] = path.stat().st_size
        row["sha256"] = hashlib.sha256(path.read_bytes()).hexdigest()
        if row["size_bytes"] <= 0 or len(row["sha256"]) != 64:
            failures.append({"id": "local_source_hash_missing", "detail": f"local source lacks nonempty sha256 proof: {path}"})
        if not pdftotext:
            row["extraction_status"] = "extractor_missing"
            failures.append({"id": "local_source_extractor_missing", "detail": "pdftotext is required to prove local PDF source extraction"})
            rows.append(row)
            continue
        try:
            proc = subprocess.run(
                [pdftotext, "-layout", str(path), "-"],
                cwd=str(ROOT),
                capture_output=True,
                text=True,
                check=False,
                timeout=30,
            )
            text = proc.stdout or ""
            row["extracted_chars"] = len(text.strip())
            row["extracted_sha256"] = hashlib.sha256(text.encode("utf-8", errors="replace")).hexdigest() if text.strip() else ""
            row["extraction_status"] = "pass" if proc.returncode == 0 and row["extracted_chars"] > 0 else "fail"
            if row["extraction_status"] != "pass":
                detail = (proc.stderr or proc.stdout or "empty extraction").strip()
                failures.append({"id": "local_source_extraction_failed", "detail": f"{path}: {detail[:240]}"})
        except subprocess.TimeoutExpired:
            row["extraction_status"] = "timeout"
            failures.append({"id": "local_source_extraction_timeout", "detail": f"local source extraction timed out: {path}"})
        rows.append(row)
    return {
        "status": "not_configured" if not corpus_configured else ("fail" if failures else "pass"),
        "source_count": len(rows),
        "required_source_count": len(LOCAL_SOURCE_INGEST_FILES),
        "total_size_bytes": sum(int(row.get("size_bytes", 0)) for row in rows),
        "extracted_char_count": sum(int(row.get("extracted_chars", 0)) for row in rows),
        "extractor": "pdftotext" if pdftotext else "",
        "sources": rows,
        "failures": failures,
        "authority": "deterministic local-source evidence audit only; it proves configured local file presence, file hashes, and extractable text hashes, not legal/tax advice or source-currentness; set GLAW_PREMIUM_SOURCE_ROOT to a portable corpus root",
    }


def local_source_ingest_ledger_markdown(report: dict[str, Any], matter_slug: str, generated_at: str) -> str:
    lines = [
        "# Local Source Ingest Evidence Ledger",
        "",
        f"matter_slug: {matter_slug}",
        f"generated_at: {generated_at}",
        f"status: {report.get('status')}",
        f"extractor: {report.get('extractor') or 'missing'}",
        f"source_count: {report.get('source_count')} / {report.get('required_source_count')}",
        f"extracted_char_count: {report.get('extracted_char_count')}",
        "",
        "Authority boundary: deterministic local-source evidence only. This ledger proves local file presence, source-file SHA-256, extractable-text SHA-256, byte counts, character counts, and lane routing. It is not legal, tax, securities, accounting, fiduciary, investment, or filing advice.",
        "",
        "| Row | Source id | Lane | Status | Source SHA-256 | Extracted SHA-256 | Path | Routing |",
        "|---|---|---|---|---|---|---|---|",
    ]
    for idx, row in enumerate(report.get("sources", []), start=1):
        source_row_id = f"LSI-{idx:04d}"
        routing = str(row.get("routing", "")).replace("|", "/")
        path = str(row.get("path", "")).replace("|", "/")
        lines.append(
            "| "
            + " | ".join([
                source_row_id,
                str(row.get("id", "")),
                str(row.get("lane", "")),
                str(row.get("extraction_status", "")),
                str(row.get("sha256", "")),
                str(row.get("extracted_sha256", "")),
                path,
                routing,
            ])
            + " |"
        )
    if report.get("failures"):
        lines.extend(["", "## Failures", ""])
        for failure in report.get("failures", []):
            lines.append(f"- {failure.get('id')}: {failure.get('detail')}")
    lines.append("")
    return "\n".join(lines)


def materialize_local_source_ingest(data: dict[str, Any], slug: str | None) -> dict[str, Any]:
    resolved_slug, path = matter_dir(slug)
    report = local_source_ingest_report(data)
    generated_at = now()
    sources = path / "sources"
    sources.mkdir(parents=True, exist_ok=True)
    ledger_rows = []
    for idx, row in enumerate(report.get("sources", []), start=1):
        if not isinstance(row, dict):
            continue
        ledger_rows.append({
            "source_row_id": f"LSI-{idx:04d}",
            "id": row.get("id"),
            "lane": row.get("lane"),
            "routing": row.get("routing"),
            "path": row.get("path"),
            "exists": row.get("exists"),
            "size_bytes": row.get("size_bytes"),
            "sha256": row.get("sha256"),
            "extractor": row.get("extractor"),
            "extraction_status": row.get("extraction_status"),
            "extracted_chars": row.get("extracted_chars"),
            "extracted_sha256": row.get("extracted_sha256"),
            "source_ingest_term_present": row.get("source_ingest_term_present"),
        })
    ledger = {
        "schema_version": 1,
        "matter_slug": resolved_slug,
        "generated_at": generated_at,
        "status": report.get("status"),
        "source_count": report.get("source_count"),
        "required_source_count": report.get("required_source_count"),
        "total_size_bytes": report.get("total_size_bytes"),
        "extracted_char_count": report.get("extracted_char_count"),
        "extractor": report.get("extractor"),
        "sources": ledger_rows,
        "failures": report.get("failures", []),
        "authority": report.get("authority"),
    }
    json_path = sources / "local-source-ingest-ledger.json"
    md_path = sources / "local-source-ingest-ledger.md"
    json_path.write_text(json.dumps(ledger, indent=2, sort_keys=False) + "\n", encoding="utf-8")
    md_path.write_text(local_source_ingest_ledger_markdown(report, resolved_slug, generated_at), encoding="utf-8")
    result = {
        "status": report.get("status"),
        "matter_slug": resolved_slug,
        "generated_at": generated_at,
        "json_path": str(json_path),
        "markdown_path": str(md_path),
        "json_sha256": hashlib.sha256(json_path.read_bytes()).hexdigest(),
        "markdown_sha256": hashlib.sha256(md_path.read_bytes()).hexdigest(),
        "source_count": report.get("source_count"),
        "required_source_count": report.get("required_source_count"),
        "extracted_char_count": report.get("extracted_char_count"),
        "failures": report.get("failures", []),
        "authority": "materializes deterministic local-source ingest proof into the matter sources folder only; no filing, signature, tax-return position, offering, transfer, or legal reliance authority",
    }
    return result


def validate_manifest(data: dict[str, Any]) -> dict[str, Any]:
    failures: list[dict[str, str]] = []
    lanes = data.get("lanes")
    if not isinstance(lanes, dict):
        failures.append({"id": "lanes", "detail": "manifest requires lanes object"})
        lanes = {}
    missing_lanes = sorted(REQUIRED_LANES - set(lanes))
    if missing_lanes:
        failures.append({"id": "required_lanes", "detail": "missing lanes: " + ", ".join(missing_lanes)})
    packet = data.get("required_packet")
    packet_text = "\n".join(str(item) for item in packet) if isinstance(packet, list) else ""
    if not isinstance(packet, list):
        failures.append({"id": "required_packet", "detail": "required_packet must be a list"})
    for term in REQUIRED_PACKET_TERMS:
        if term not in packet_text:
            failures.append({"id": "required_packet", "detail": f"missing packet term: {term}"})
    no_go = data.get("hard_no_go")
    no_go_text = "\n".join(str(item) for item in no_go) if isinstance(no_go, list) else ""
    if not isinstance(no_go, list):
        failures.append({"id": "hard_no_go", "detail": "hard_no_go must be a list"})
    for term in REQUIRED_NO_GO_TERMS:
        if term not in no_go_text:
            failures.append({"id": "hard_no_go", "detail": f"missing no-go term: {term}"})
    for lane_id, lane in sorted(lanes.items()):
        if not isinstance(lane, dict):
            failures.append({"id": "lane_shape", "detail": f"{lane_id} must be an object"})
            continue
        for field in REQUIRED_LANE_FIELDS:
            if field not in lane:
                failures.append({"id": "lane_field", "detail": f"{lane_id} missing {field}"})
        for field in ("track_defaults", "lead_seats", "workstreams", "phase_playbook", "required_lane_packet", "adversarial_reviewers", "docket_items"):
            value = lane.get(field)
            if not isinstance(value, list) or len(value) < 3:
                failures.append({"id": "lane_depth", "detail": f"{lane_id}.{field} needs at least 3 entries"})
        if not any("glaw" in str(seat) for seat in lane.get("lead_seats", [])):
            failures.append({"id": "lead_seats", "detail": f"{lane_id} has no GLAW lead seat"})
        reviewers = "\n".join(str(item) for item in lane.get("adversarial_reviewers", []))
        if not any(term in reviewers for term in ("IRS", "SEC", "tax", "regulator")):
            failures.append({"id": "adversarial_reviewers", "detail": f"{lane_id} lacks regulator/tax adversary"})
        benchmark_items = lane.get("creative_planning_required")
        benchmark_text = "\n".join(str(item) for item in benchmark_items) if isinstance(benchmark_items, list) else ""
        if lane.get("benchmark_required", True):
            if not isinstance(benchmark_items, list) or len(benchmark_items) < len(CREATIVE_PLANNING_BENCHMARK_TERMS):
                failures.append({"id": "creative_planning_required", "detail": f"{lane_id} needs full Creative Planning integrated advisory benchmark checklist"})
            for term in CREATIVE_PLANNING_BENCHMARK_TERMS:
                if term not in benchmark_text:
                    failures.append({"id": "creative_planning_required", "detail": f"{lane_id} missing Creative Planning benchmark item: {term}"})
        if lane_id == "uhnw-family-office":
            taxonomy = lane.get("trust_taxonomy_required")
            taxonomy_text = "\n".join(str(item) for item in taxonomy) if isinstance(taxonomy, list) else ""
            if not isinstance(taxonomy, list) or len(taxonomy) < len(UHNW_TRUST_TAXONOMY_TERMS):
                failures.append({"id": "trust_taxonomy_required", "detail": "uhnw-family-office needs full trust taxonomy list"})
            for term in UHNW_TRUST_TAXONOMY_TERMS:
                if term not in taxonomy_text:
                    failures.append({"id": "trust_taxonomy_required", "detail": f"uhnw-family-office missing trust type: {term}"})
            schwab_topics = lane.get("schwab_trust_topic_required")
            schwab_text = "\n".join(str(item) for item in schwab_topics) if isinstance(schwab_topics, list) else ""
            if not isinstance(schwab_topics, list) or len(schwab_topics) < len(SCHWAB_TRUST_TOPIC_TERMS):
                failures.append({"id": "schwab_trust_topic_required", "detail": "uhnw-family-office needs full Schwab trusts topic-index checklist"})
            for term in SCHWAB_TRUST_TOPIC_TERMS:
                if term not in schwab_text:
                    failures.append({"id": "schwab_trust_topic_required", "detail": f"uhnw-family-office missing Schwab trust topic: {term}"})
            topology_items = lane.get("entity_topology_required")
            topology_text = "\n".join(str(item) for item in topology_items) if isinstance(topology_items, list) else ""
            if not isinstance(topology_items, list) or len(topology_items) < len(ENTITY_TOPOLOGY_TERMS):
                failures.append({"id": "entity_topology_required", "detail": "uhnw-family-office needs full dynasty/investment trust plus investment LLC topology checklist"})
            for term in ENTITY_TOPOLOGY_TERMS:
                if term not in topology_text:
                    failures.append({"id": "entity_topology_required", "detail": f"uhnw-family-office missing entity topology item: {term}"})
        if lane_id == "founder-unicorn":
            raise_items = lane.get("capital_raise_required")
            raise_text = "\n".join(str(item) for item in raise_items) if isinstance(raise_items, list) else ""
            if not isinstance(raise_items, list) or len(raise_items) < len(FOUNDER_CAPITAL_RAISE_TERMS):
                failures.append({"id": "capital_raise_required", "detail": "founder-unicorn needs full capital raise checklist"})
            for term in FOUNDER_CAPITAL_RAISE_TERMS:
                if term not in raise_text:
                    failures.append({"id": "capital_raise_required", "detail": f"founder-unicorn missing capital raise item: {term}"})
            investor_items = lane.get("investor_required")
            investor_text = "\n".join(str(item) for item in investor_items) if isinstance(investor_items, list) else ""
            if not isinstance(investor_items, list) or len(investor_items) < len(INVESTOR_PURPOSE_TERMS):
                failures.append({"id": "investor_required", "detail": "founder-unicorn needs full investor-purpose checklist"})
            for term in INVESTOR_PURPOSE_TERMS:
                if term not in investor_text:
                    failures.append({"id": "investor_required", "detail": f"founder-unicorn missing investor-purpose item: {term}"})
            qsbs_items = lane.get("qsbs_required")
            qsbs_text = "\n".join(str(item) for item in qsbs_items) if isinstance(qsbs_items, list) else ""
            if not isinstance(qsbs_items, list) or len(qsbs_items) < len(QSBS_CERTIFICATE_TERMS):
                failures.append({"id": "qsbs_required", "detail": "founder-unicorn needs full QSBS issuer/shareholder certificate checklist"})
            for term in QSBS_CERTIFICATE_TERMS:
                if term not in qsbs_text:
                    failures.append({"id": "qsbs_required", "detail": f"founder-unicorn missing QSBS certificate item: {term}"})
            topology_items = lane.get("entity_topology_required")
            topology_text = "\n".join(str(item) for item in topology_items) if isinstance(topology_items, list) else ""
            if not isinstance(topology_items, list) or len(topology_items) < len(ENTITY_TOPOLOGY_TERMS):
                failures.append({"id": "entity_topology_required", "detail": "founder-unicorn needs full dynasty/investment trust plus investment LLC topology checklist"})
            for term in ENTITY_TOPOLOGY_TERMS:
                if term not in topology_text:
                    failures.append({"id": "entity_topology_required", "detail": f"founder-unicorn missing entity topology item: {term}"})
            source_items = lane.get("source_ingest_required")
            source_text = "\n".join(str(item) for item in source_items) if isinstance(source_items, list) else ""
            if not isinstance(source_items, list) or len(source_items) < len(SOURCE_INGEST_TERMS):
                failures.append({"id": "source_ingest_required", "detail": "founder-unicorn needs full local source-ingest checklist"})
            for term in SOURCE_INGEST_TERMS:
                if term not in source_text:
                    failures.append({"id": "source_ingest_required", "detail": f"founder-unicorn missing source-ingest item: {term}"})
        if lane_id == "tax-system":
            tax_items = lane.get("tax_engine_required")
            tax_text = "\n".join(str(item) for item in tax_items) if isinstance(tax_items, list) else ""
            if not isinstance(tax_items, list) or len(tax_items) < len(TAX_ENGINE_TERMS):
                failures.append({"id": "tax_engine_required", "detail": "tax-system needs full tax engine checklist"})
            for term in TAX_ENGINE_TERMS:
                if term not in tax_text:
                    failures.append({"id": "tax_engine_required", "detail": f"tax-system missing tax engine item: {term}"})
            credit_items = lane.get("tax_credit_required")
            credit_text = "\n".join(str(item) for item in credit_items) if isinstance(credit_items, list) else ""
            if not isinstance(credit_items, list) or len(credit_items) < len(TAX_CREDIT_TERMS):
                failures.append({"id": "tax_credit_required", "detail": "tax-system needs full tax-credit substantiation checklist"})
            for term in TAX_CREDIT_TERMS:
                if term not in credit_text:
                    failures.append({"id": "tax_credit_required", "detail": f"tax-system missing tax-credit item: {term}"})
            source_items = lane.get("source_ingest_required")
            source_text = "\n".join(str(item) for item in source_items) if isinstance(source_items, list) else ""
            if not isinstance(source_items, list) or len(source_items) < len(SOURCE_INGEST_TERMS):
                failures.append({"id": "source_ingest_required", "detail": "tax-system needs full local source-ingest checklist"})
            for term in SOURCE_INGEST_TERMS:
                if term not in source_text:
                    failures.append({"id": "source_ingest_required", "detail": f"tax-system missing source-ingest item: {term}"})
        if lane_id == "fortune500-enterprise":
            enterprise_items = lane.get("enterprise_required")
            enterprise_text = "\n".join(str(item) for item in enterprise_items) if isinstance(enterprise_items, list) else ""
            if not isinstance(enterprise_items, list) or len(enterprise_items) < len(ENTERPRISE_GOVERNANCE_TERMS):
                failures.append({"id": "enterprise_required", "detail": "fortune500-enterprise needs full enterprise governance/reporting/control checklist"})
            for term in ENTERPRISE_GOVERNANCE_TERMS:
                if term not in enterprise_text:
                    failures.append({"id": "enterprise_required", "detail": f"fortune500-enterprise missing enterprise item: {term}"})
    return {
        "status": "fail" if failures else "pass",
        "lane_count": len(lanes),
        "lanes": sorted(lanes),
        "failures": failures,
        "authority": "premium lane packets are attorney/CPA work-product scaffolds; they do not file, sign, transmit, or give legal advice",
    }


def objective_audit(data: dict[str, Any]) -> dict[str, Any]:
    manifest_report = validate_manifest(data)
    trust_report = trust_taxonomy_report(data)
    blueprint_report = founder_blueprint(data, "premium-objective-audit")
    tax_blueprint_report = tax_engine_blueprint(data, "premium-objective-audit")
    enterprise_blueprint_report = enterprise_blueprint(data, "premium-objective-audit")
    firm_blueprint_report = firm_blueprint(data, "premium-objective-audit")
    source_ingest_report = local_source_ingest_report(data)
    lanes = data.get("lanes") if isinstance(data.get("lanes"), dict) else {}
    rows: list[dict[str, Any]] = []
    failures: list[dict[str, str]] = []
    for requirement in OBJECTIVE_AUDIT_REQUIREMENTS:
        lane_id = str(requirement["lane"])
        lane = lanes.get(lane_id) if isinstance(lanes, dict) else None
        row_failures: list[dict[str, str]] = []
        evidence: list[str] = []
        if not isinstance(lane, dict):
            row_failures.append({"id": "lane_missing", "detail": f"{lane_id} missing"})
        else:
            field_text = "\n".join(
                "\n".join(str(item) for item in lane.get(field, []))
                for field in requirement["fields"]
            )
            for term in requirement["terms"]:
                if term in field_text:
                    evidence.append(term)
                else:
                    row_failures.append({"id": "objective_term_missing", "detail": f"{requirement['id']} missing term: {term}"})
            lead_seats = lane.get("lead_seats")
            reviewers = lane.get("adversarial_reviewers")
            if not isinstance(lead_seats, list) or not lead_seats:
                row_failures.append({"id": "lead_seats_missing", "detail": f"{requirement['id']} lacks lead seats"})
            if not isinstance(reviewers, list) or not reviewers:
                row_failures.append({"id": "adversarial_reviewers_missing", "detail": f"{requirement['id']} lacks adversarial reviewers"})
        for ref in requirement["references"]:
            path = ROOT / str(ref)
            if path.is_file() and path.stat().st_size > 0:
                evidence.append(str(ref))
            else:
                row_failures.append({"id": "reference_missing", "detail": f"{requirement['id']} missing reference: {ref}"})
        rows.append({
            "id": requirement["id"],
            "label": requirement["label"],
            "lane_id": lane_id,
            "status": "fail" if row_failures else "pass",
            "fields": list(requirement["fields"]),
            "evidence": evidence,
            "failures": row_failures,
        })
        failures.extend(row_failures)

    if manifest_report.get("status") != "pass":
        failures.extend({"id": "manifest_validation", "detail": item.get("detail", "")} for item in manifest_report.get("failures", []))
    if trust_report.get("status") != "pass":
        failures.extend({"id": "trust_taxonomy_audit", "detail": item.get("detail", "")} for item in trust_report.get("failures", []))
    if blueprint_report.get("status") != "pass":
        failures.extend({"id": "founder_blueprint_audit", "detail": item.get("detail", "")} for item in blueprint_report.get("failures", []))
    if tax_blueprint_report.get("status") != "pass":
        failures.extend({"id": "tax_engine_blueprint_audit", "detail": item.get("detail", "")} for item in tax_blueprint_report.get("failures", []))
    if enterprise_blueprint_report.get("status") != "pass":
        failures.extend({"id": "enterprise_blueprint_audit", "detail": item.get("detail", "")} for item in enterprise_blueprint_report.get("failures", []))
    if firm_blueprint_report.get("status") != "pass":
        failures.extend({"id": "firm_blueprint_audit", "detail": item.get("detail", "")} for item in firm_blueprint_report.get("failures", []))
    if source_ingest_report.get("status") not in {"pass", "not_configured"}:
        failures.extend({"id": "local_source_ingest_audit", "detail": item.get("detail", "")} for item in source_ingest_report.get("failures", []))

    required_tools = (
        "bin/glaw-intake",
        "bin/glaw-premium-lanes",
        "bin/glaw-final-packet",
        "bin/glaw-gate",
        "lib/glaw_premium_scope.py",
        "lib/glaw_headless.py",
    )
    tool_rows: list[dict[str, str]] = []
    for rel in required_tools:
        path = ROOT / rel
        status = "pass" if path.is_file() and path.stat().st_size > 0 else "fail"
        tool_rows.append({"path": rel, "status": status})
        if status != "pass":
            failures.append({"id": "tool_missing", "detail": f"required objective tool missing: {rel}"})

    return {
        "status": "fail" if failures else "pass",
        "objective": "Fortune 500 lawyer, tax system, entrepreneur/founder, investor/capital raise, QSBS, trust, and premium-lane GLAW buildout",
        "manifest_status": manifest_report.get("status"),
        "manifest_sha256": manifest_sha256(),
        "trust_taxonomy_status": trust_report.get("status"),
        "trust_taxonomy_summary": {
            "trust_type_count": trust_report.get("trust_type_count"),
            "required_type_count": trust_report.get("required_type_count"),
            "source": trust_report.get("source"),
            "default_topology": trust_report.get("default_topology", {}),
            "direct_ownership_carveout_count": len(trust_report.get("direct_ownership_carveouts", [])),
            "direct_ownership_carveouts": trust_report.get("direct_ownership_carveouts", []),
            "schwab_benchmark": trust_report.get("schwab_benchmark", {}),
        },
        "founder_blueprint_status": blueprint_report.get("status"),
        "founder_blueprint_summary": {
            "lanes": blueprint_report.get("lanes", []),
            "phase_count": len(blueprint_report.get("sequence", [])),
            "phase_names": [item.get("phase") for item in blueprint_report.get("sequence", []) if isinstance(item, dict)],
            "lead_seat_count": len(blueprint_report.get("lead_seats", [])),
            "docket_item_count": len(blueprint_report.get("docket_items", [])),
            "adversarial_reviewer_count": len(blueprint_report.get("adversarial_reviewers", [])),
            "source_ingest_item_count": len(blueprint_report.get("source_ingest_required", [])),
            "trust_type_count": blueprint_report.get("trust_taxonomy", {}).get("trust_type_count"),
            "direct_ownership_carveout_count": len(blueprint_report.get("trust_taxonomy", {}).get("direct_ownership_carveouts", [])),
            "kickoff_commands": blueprint_report.get("kickoff_commands", []),
        },
        "tax_engine_blueprint_status": tax_blueprint_report.get("status"),
        "tax_engine_blueprint_summary": {
            "lanes": tax_blueprint_report.get("lanes", []),
            "phase_count": len(tax_blueprint_report.get("sequence", [])),
            "phase_names": [item.get("phase") for item in tax_blueprint_report.get("sequence", []) if isinstance(item, dict)],
            "lead_seat_count": len(tax_blueprint_report.get("lead_seats", [])),
            "tax_engine_item_count": len(tax_blueprint_report.get("tax_engine_required", [])),
            "tax_credit_item_count": len(tax_blueprint_report.get("tax_credit_required", [])),
            "source_ingest_item_count": len(tax_blueprint_report.get("source_ingest_required", [])),
            "creative_planning_item_count": len(tax_blueprint_report.get("creative_planning_required", [])),
            "docket_item_count": len(tax_blueprint_report.get("docket_items", [])),
            "adversarial_reviewer_count": len(tax_blueprint_report.get("adversarial_reviewers", [])),
            "kickoff_commands": tax_blueprint_report.get("kickoff_commands", []),
        },
        "enterprise_blueprint_status": enterprise_blueprint_report.get("status"),
        "enterprise_blueprint_summary": {
            "lanes": enterprise_blueprint_report.get("lanes", []),
            "phase_count": len(enterprise_blueprint_report.get("sequence", [])),
            "phase_names": [item.get("phase") for item in enterprise_blueprint_report.get("sequence", []) if isinstance(item, dict)],
            "lead_seat_count": len(enterprise_blueprint_report.get("lead_seats", [])),
            "enterprise_item_count": len(enterprise_blueprint_report.get("enterprise_required", [])),
            "creative_planning_item_count": len(enterprise_blueprint_report.get("creative_planning_required", [])),
            "required_packet_count": len(enterprise_blueprint_report.get("required_packet", [])),
            "docket_item_count": len(enterprise_blueprint_report.get("docket_items", [])),
            "adversarial_reviewer_count": len(enterprise_blueprint_report.get("adversarial_reviewers", [])),
            "kickoff_commands": enterprise_blueprint_report.get("kickoff_commands", []),
        },
        "firm_blueprint_status": firm_blueprint_report.get("status"),
        "firm_blueprint_summary": {
            "lanes": firm_blueprint_report.get("lanes", []),
            "phase_count": len(firm_blueprint_report.get("sequence", [])),
            "phase_names": [item.get("phase") for item in firm_blueprint_report.get("sequence", []) if isinstance(item, dict)],
            "lead_seat_count": len(firm_blueprint_report.get("lead_seats", [])),
            "docket_item_count": len(firm_blueprint_report.get("docket_items", [])),
            "adversarial_reviewer_count": len(firm_blueprint_report.get("adversarial_reviewers", [])),
            "component_statuses": firm_blueprint_report.get("component_statuses", {}),
            "source_count": firm_blueprint_report.get("source_ingest", {}).get("source_count"),
            "trust_type_count": firm_blueprint_report.get("trust_taxonomy", {}).get("trust_type_count"),
            "kickoff_commands": firm_blueprint_report.get("kickoff_commands", []),
        },
        "local_source_ingest_status": source_ingest_report.get("status"),
        "local_source_ingest_summary": {
            "source_count": source_ingest_report.get("source_count"),
            "required_source_count": source_ingest_report.get("required_source_count"),
            "total_size_bytes": source_ingest_report.get("total_size_bytes"),
            "extracted_char_count": source_ingest_report.get("extracted_char_count"),
            "extractor": source_ingest_report.get("extractor"),
            "sources": [
                {
                    "id": row.get("id"),
                    "path": row.get("path"),
                    "lane": row.get("lane"),
                    "sha256": row.get("sha256"),
                    "size_bytes": row.get("size_bytes"),
                    "extraction_status": row.get("extraction_status"),
                    "extracted_chars": row.get("extracted_chars"),
                    "extracted_sha256": row.get("extracted_sha256"),
                }
                for row in source_ingest_report.get("sources", [])
                if isinstance(row, dict)
            ],
        },
        "requirements": rows,
        "tools": tool_rows,
        "failures": failures,
        "authority": "deterministic coverage audit only; it proves local GLAW objective surfaces exist, not legal/tax advice or live filing authority",
    }


def parse_trust_taxonomy_rows() -> list[dict[str, Any]]:
    if not TRUST_TAXONOMY_REFERENCE.is_file():
        return []
    rows: list[dict[str, Any]] = []
    in_table = False
    for line in TRUST_TAXONOMY_REFERENCE.read_text(encoding="utf-8", errors="replace").splitlines():
        if line.startswith("| Type | Main job | Tax posture | Key administration | GLAW routing |"):
            in_table = True
            continue
        if not in_table:
            continue
        if line.startswith("|---"):
            continue
        if not line.startswith("|"):
            if rows:
                break
            continue
        parts = [part.strip() for part in line.strip().strip("|").split("|")]
        if len(parts) != 5:
            continue
        trust_type, main_job, tax_posture, key_administration, routing = parts
        routing_seats = [seat.strip(" `") for seat in routing.split(",") if seat.strip()]
        rows.append({
            "type": trust_type,
            "main_job": main_job,
            "tax_posture": tax_posture,
            "key_administration": key_administration,
            "routing": routing_seats,
        })
    return rows


def trust_taxonomy_report(data: dict[str, Any]) -> dict[str, Any]:
    rows = parse_trust_taxonomy_rows()
    row_types = {row.get("type", "") for row in rows}
    failures: list[dict[str, str]] = []
    for trust_type in ALL_TRUST_REQUIRED_TYPES:
        if trust_type not in row_types:
            failures.append({"id": "trust_type_missing", "detail": f"missing trust type: {trust_type}"})
    for rel, path in (
        ("seats/glaw-tax-strategy/references/trust-taxonomy-routing.md", TRUST_TAXONOMY_REFERENCE),
        ("seats/glaw-tax-strategy/references/trusts-for-tax-and-protection.md", TRUST_TOPOLOGY_REFERENCE),
        ("seats/glaw-tax-strategy/references/schwab-trusts-benchmark.md", SCHWAB_TRUST_REFERENCE),
    ):
        if not path.is_file() or path.stat().st_size <= 0:
            failures.append({"id": "reference_missing", "detail": f"missing reference: {rel}"})
    lanes = data.get("lanes") if isinstance(data.get("lanes"), dict) else {}
    uhnw_lane = lanes.get("uhnw-family-office") if isinstance(lanes, dict) else None
    if not isinstance(uhnw_lane, dict):
        failures.append({"id": "lane_missing", "detail": "uhnw-family-office missing"})
        uhnw_lane = {}
    taxonomy_text = "\n".join(str(item) for item in uhnw_lane.get("trust_taxonomy_required", []))
    for term in UHNW_TRUST_TAXONOMY_TERMS:
        if term not in taxonomy_text:
            failures.append({"id": "uhnw_taxonomy_missing", "detail": f"UHNW lane missing taxonomy term: {term}"})
    topology_text = "\n".join(str(item) for item in uhnw_lane.get("entity_topology_required", []))
    for term in ENTITY_TOPOLOGY_TERMS:
        if term not in topology_text:
            failures.append({"id": "entity_topology_missing", "detail": f"UHNW lane missing topology term: {term}"})
    schwab_text = "\n".join(str(item) for item in uhnw_lane.get("schwab_trust_topic_required", []))
    for term in SCHWAB_TRUST_TOPIC_TERMS:
        if term not in schwab_text:
            failures.append({"id": "schwab_topic_missing", "detail": f"UHNW lane missing Schwab topic: {term}"})
    return {
        "status": "fail" if failures else "pass",
        "trust_type_count": len(rows),
        "required_type_count": len(ALL_TRUST_REQUIRED_TYPES),
        "source": str(TRUST_TAXONOMY_REFERENCE.relative_to(ROOT)),
        "manifest_sha256": manifest_sha256(),
        "trust_types": rows,
        "default_topology": {
            "chassis": "irrevocable dynasty or investment trust owns an investment LLC for diversified investments and family investment administration",
            "direct_ownership_rule": "assets bypass the investment LLC when tax, issuer, transfer, securities, ERISA, insurance, or fiduciary rules make direct trust ownership preferable",
        },
        "direct_ownership_carveouts": list(ENTITY_TOPOLOGY_TERMS),
        "schwab_benchmark": {
            "source": "https://www.schwab.com/learn/topic/trusts",
            "reference": str(SCHWAB_TRUST_REFERENCE.relative_to(ROOT)),
            "required_topics": list(SCHWAB_TRUST_TOPIC_TERMS),
        },
        "failures": failures,
        "authority": "deterministic trust taxonomy and routing audit only; licensed counsel, tax, fiduciary, securities, and investment review remains required before implementation",
    }


def lane_or_fail(data: dict[str, Any], lane_id: str) -> dict[str, Any]:
    lanes = data.get("lanes", {})
    lane = lanes.get(lane_id)
    if not isinstance(lane, dict):
        raise SystemExit(f"unknown lane '{lane_id}'. valid lanes: {', '.join(sorted(lanes))}")
    return lane


def scaffold(data: dict[str, Any], lane_id: str, matter: str) -> dict[str, Any]:
    lane = lane_or_fail(data, lane_id)
    required_packet = list(data["required_packet"]) + list(lane.get("required_lane_packet", []))
    return {
        "matter": matter,
        "lane_id": lane_id,
        "lane_name": lane["name"],
        "manifest_source": str(MANIFEST.relative_to(ROOT)),
        "manifest_version": data.get("version"),
        "manifest_sha256": manifest_sha256(),
        "scaffolded_at": now(),
        "track_defaults": lane["track_defaults"],
        "lead_seats": lane["lead_seats"],
        "workstreams": [{"name": item, "owner": "", "status": "not_started"} for item in lane["workstreams"]],
        "phase_playbook": [{"phase": item, "owner": "", "status": "not_started"} for item in lane.get("phase_playbook", [])],
        "required_packet": [{"item": item, "owner": "", "status": "not_started"} for item in required_packet],
        "required_lane_packet": [{"item": item, "owner": "", "status": "not_started"} for item in lane.get("required_lane_packet", [])],
        **{
            field: [{key: item, "owner": "", "status": "not_started"} for item in lane.get(field, [])]
            for field, (key, _terms, _proof) in OPTIONAL_CHECKLISTS.items()
            if field in lane
        },
        "adversarial_reviewers": [{"reviewer": item, "status": "not_started"} for item in lane["adversarial_reviewers"]],
        "docket_items": [{"item": item, "due": "", "source": "SRC-0001", "owner": ""} for item in lane["docket_items"]],
        "hard_no_go": data["hard_no_go"],
        "gates": [
            "structured intake complete",
            "conflicts cleared",
            "citations verified",
            "adversarial RED to BLUE",
            "red flags clear or carried",
            "final packet ready",
            "Chief/Council approved",
            "UPL footer",
            "docket gate complete",
        ],
        "authority": "draft planning scaffold only; licensed counsel/CPA review and human authority required for filings, signatures, payments, and live submissions",
    }


def playbook(data: dict[str, Any], lane_id: str, matter: str) -> dict[str, Any]:
    lane = lane_or_fail(data, lane_id)
    required_packet = list(data["required_packet"]) + list(lane.get("required_lane_packet", []))
    return {
        "matter": matter,
        "lane_id": lane_id,
        "lane_name": lane["name"],
        "source": str(MANIFEST.relative_to(ROOT)),
        "manifest_version": data.get("version"),
        "manifest_sha256": manifest_sha256(),
        "recommended_track_defaults": lane.get("track_defaults", []),
        "lead_seats": lane.get("lead_seats", []),
        "kickoff_commands": [
            f"bin/glaw matter new {json.dumps(matter)}",
            f"bin/glaw-premium-lanes attach {lane_id}",
            f"bin/glaw-premium-lanes complete --lane {lane_id} --owner \"named lead\" --docket-owner \"docket owner\" --due YYYY-MM-DD --source \"SRC-0001 basis\"",
            f"bin/glaw-premium-lanes render-packet --lane {lane_id} --owner \"named lead\" --source \"SRC-0001 basis\"",
            f"bin/glaw-premium-lanes check-packet --lane {lane_id}",
            f"bin/glaw-premium-lanes docket --lane {lane_id}",
        ],
        "phases": [{"phase": item, "gate": "owner, source evidence, reviewer survival, and docket owner required"} for item in lane.get("phase_playbook", [])],
        "workstreams": [{"name": item, "owner": ""} for item in lane.get("workstreams", [])],
        "required_packet": [{"item": item, "owner": "", "proof": "source-backed workpaper or rendered packet template"} for item in required_packet],
        **{
            field: [{key: item, "proof": proof} for item in lane.get(field, [])]
            for field, (key, _terms, proof) in OPTIONAL_CHECKLISTS.items()
            if field in lane
        },
        "adversarial_reviewers": [{"reviewer": item, "attack_required": True} for item in lane.get("adversarial_reviewers", [])],
        "docket_items": [{"item": item, "source": "SRC-0001 basis", "owner": "", "due": "YYYY-MM-DD"} for item in lane.get("docket_items", [])],
        "hard_no_go": data.get("hard_no_go", []),
        "gate_sequence": [
            "structured intake complete",
            "conflicts cleared",
            "premium lane packet attached",
            "owners and phase playbook complete",
            "adversarial reviewers survived",
            "rendered templates hashed",
            "docket rows materialized",
            "final packet rebuilt",
            "Chief/Council approved",
        ],
        "authority": "source-only kickoff playbook; it does not give legal, tax, investment, accounting, fiduciary, or securities advice and does not authorize filing, signing, payment, transmission, offering, transfer, or tax-return positions",
    }


def playbook_markdown(plan: dict[str, Any]) -> str:
    def bullets(items: list[Any], key: str | None = None) -> str:
        rows: list[str] = []
        for item in items:
            if isinstance(item, dict):
                value = item.get(key or "item") or item.get("name") or item.get("phase") or item.get("reviewer") or ""
            else:
                value = item
            rows.append(f"- {value}")
        return "\n".join(rows) or "- none"

    commands = "\n".join(str(cmd) for cmd in plan.get("kickoff_commands", []))
    return f"""# {plan.get('lane_name', 'Premium Lane')} Kickoff Playbook

Matter: {plan.get('matter', '')}
Lane ID: {plan.get('lane_id', '')}
Source: {plan.get('source', '')}

## Recommended Tracks

{bullets(plan.get('recommended_track_defaults', []))}

## Lead Seats

{bullets(plan.get('lead_seats', []))}

## Kickoff Commands

```bash
{commands}
```

## Phase Gates

{bullets(plan.get('phases', []), 'phase')}

## Required Packet

{bullets(plan.get('required_packet', []), 'item')}

## Creative Planning Required

{bullets(plan.get('creative_planning_required', []), 'item')}

## Trust Taxonomy Required

{bullets(plan.get('trust_taxonomy_required', []), 'type')}

## Schwab Trust Topic Required

{bullets(plan.get('schwab_trust_topic_required', []), 'topic')}

## Entity Topology Required

{bullets(plan.get('entity_topology_required', []), 'item')}

## Source Ingest Required

{bullets(plan.get('source_ingest_required', []), 'item')}

## Capital Raise Required

{bullets(plan.get('capital_raise_required', []), 'item')}

## Investor Required

{bullets(plan.get('investor_required', []), 'item')}

## QSBS Required

{bullets(plan.get('qsbs_required', []), 'item')}

## Tax Credit Required

{bullets(plan.get('tax_credit_required', []), 'item')}

## Tax Engine Required

{bullets(plan.get('tax_engine_required', []), 'item')}

## Enterprise Required

{bullets(plan.get('enterprise_required', []), 'item')}

## Adversarial Reviewers

{bullets(plan.get('adversarial_reviewers', []), 'reviewer')}

## Docket Items

{bullets(plan.get('docket_items', []), 'item')}

## Hard No-Go Controls

{bullets(plan.get('hard_no_go', []))}

## Gate Sequence

{bullets(plan.get('gate_sequence', []))}

## Authority Boundary

{plan.get('authority', '')}
"""


def _items(lane: dict[str, Any], field: str) -> list[str]:
    values = lane.get(field, [])
    return [str(item) for item in values] if isinstance(values, list) else []


def founder_blueprint(data: dict[str, Any], matter: str) -> dict[str, Any]:
    founder = lane_or_fail(data, "founder-unicorn")
    uhnw = lane_or_fail(data, "uhnw-family-office")
    trust_report = trust_taxonomy_report(data)
    capital_raise = _items(founder, "capital_raise_required")
    investor = _items(founder, "investor_required")
    qsbs = _items(founder, "qsbs_required")
    topology = _items(founder, "entity_topology_required") or _items(uhnw, "entity_topology_required")
    source_ingest = _items(founder, "source_ingest_required")
    required_packet = list(data.get("required_packet", [])) + _items(founder, "required_lane_packet")
