def firm_blueprint(data: dict[str, Any], matter: str) -> dict[str, Any]:
    enterprise = enterprise_blueprint(data, matter)
    tax = tax_engine_blueprint(data, matter)
    founder = founder_blueprint(data, matter)
    trust_report = trust_taxonomy_report(data)
    source_report = local_source_ingest_report(data)
    lanes = ["fortune500-enterprise", "tax-system", "founder-unicorn", "uhnw-family-office"]
    failures: list[dict[str, str]] = []
    components = {
        "enterprise": enterprise.get("status"),
        "tax_engine": tax.get("status"),
        "founder": founder.get("status"),
        "trust_taxonomy": trust_report.get("status"),
        "local_source_ingest": source_report.get("status"),
    }
    for name, status in components.items():
        if status != "pass" and not (name == "local_source_ingest" and status == "not_configured"):
            failures.append({"id": "component_failed", "detail": f"{name} component status is {status}"})
    required_terms = (
        "Fortune 500 enterprise",
        "tax system",
        "founder",
        "investor",
        "QSBS",
        "dynasty/investment trust",
        "investment LLC",
        "source ingest",
        "final packet",
        "Chief approval",
    )
    proof_text = "\n".join(
        str(item)
        for item in (
            enterprise.get("sequence", [])
            + tax.get("sequence", [])
            + founder.get("sequence", [])
            + enterprise.get("kickoff_commands", [])
            + tax.get("kickoff_commands", [])
            + founder.get("kickoff_commands", [])
            + ["Fortune 500 enterprise", "tax system"]
        )
    )
    for term in required_terms:
        if term not in proof_text:
            failures.append({"id": "firm_blueprint_term_missing", "detail": f"missing firm blueprint term: {term}"})
    lead_seats = sorted(set(
        enterprise.get("lead_seats", [])
        + tax.get("lead_seats", [])
        + founder.get("lead_seats", [])
    ))
    docket_items = sorted(set(
        enterprise.get("docket_items", [])
        + tax.get("docket_items", [])
        + founder.get("docket_items", [])
    ))
    adversarial = sorted(set(
        enterprise.get("adversarial_reviewers", [])
        + tax.get("adversarial_reviewers", [])
        + founder.get("adversarial_reviewers", [])
        + [
            "IRS examiner",
            "SEC enforcement/disclosure reviewer",
            "auditor/PCAOB lens",
            "investor counsel",
            "trustee/fiduciary reviewer",
            "creditor/fraudulent-transfer reviewer",
            "Chief Compliance Officer",
            "outside critic",
        ]
    ))
    return {
        "status": "fail" if failures else "pass",
        "matter": matter,
        "source": str(MANIFEST.relative_to(ROOT)),
        "manifest_version": data.get("version"),
        "manifest_sha256": manifest_sha256(),
        "lanes": lanes,
        "component_statuses": components,
        "lead_seats": lead_seats,
        "sequence": [
            {
                "phase": "1. One front door: intake, conflicts, source ingest, and jurisdiction",
                "owner": "/glaw-intake + /glaw-ethics-conflicts + /glaw-jurisdiction + glaw-tax-legal-intake",
                "outputs": [
                    "premium tags for Fortune 500 enterprise, tax system, founder, investor/capital raise, and UHNW/family-office facts",
                    "conflicts, engagement, UPL, jurisdiction pack, current figures, citation corpus, and local source ingest before strategy",
                    "materialized source-ingest ledger for TAX CREDIT, LLC, SEC, QSBS, trust, offering, investor, and tax-publication sources",
                ],
                "gate": "no strategy, tax position, investor communication, transfer, or public-company use until intake, ethics, and source evidence are current",
            },
            {
                "phase": "2. Fortune 500 enterprise bench",
                "owner": "/glaw-sec-reporting + /glaw-accounting + /glaw-compliance + glaw-corporate-counsel",
                "outputs": [
                    "board authority, delegation, subsidiaries, signatories, approvals, beneficial ownership, annual report, and franchise-tax map",
                    "SEC 10-K/10-Q/8-K/S-1/proxy/Form 4, Reg S-K, Reg S-X, Inline XBRL, MD&A, risk-factor, KPI, non-GAAP, and Reg FD controls",
                    "SOX 302/906, SOX 404 ICFR, audit/PBC/PCAOB, ASC 740 tax provision, enterprise regulatory, enforcement, and litigation-hold packet",
                ],
                "required": enterprise.get("enterprise_required", [])[:10],
            },
            {
                "phase": "3. Tax system and IRS engine",
                "owner": "glaw-tax-strategy + /glaw-tax-provision + /glaw-credit-strategy + /glaw-irs-audit",
                "outputs": [
                    "entity classification, elections, basis, QSBS, controlled-group, SALT, international, trust 1041/DNI, gift/GST, and filing calendar",
                    "GL trial-balance to book-to-tax M-1/M-3, return-line map, ASC 740, ETR, UTP, deferred-tax, and auditor-PBC bridge",
                    "tax credit inventory, substantiation, Form 3800/6765/3468/8974/8275, transferability/direct-pay, recapture, controversy, and no-live-filing handoff",
                ],
                "required": tax.get("tax_engine_required", [])[:10],
            },
            {
                "phase": "4. Entrepreneur, founder, QSBS, and capital raise",
                "owner": "glaw-corporate-counsel + glaw-pe-vc-counsel + /glaw-fund-regulatory-council + /glaw-83b-election",
