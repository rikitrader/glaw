def founder_blueprint_markdown(plan: dict[str, Any]) -> str:
    def bullets(items: list[Any]) -> str:
        return "\n".join(f"- {item}" for item in items) or "- none"

    phase_blocks = []
    for phase in plan.get("sequence", []):
        outputs = bullets(phase.get("outputs", []))
        required = bullets(phase.get("required", [])[:8])
        phase_blocks.append(
            f"## {phase.get('phase')}\n\n"
            f"Owner: {phase.get('owner')}\n\n"
            f"Gate: {phase.get('gate', 'source-backed owner/reviewer/docket proof required')}\n\n"
            f"Outputs:\n{outputs}\n\n"
            f"Required controls:\n{required}"
        )
    return f"""# Founder Capital, Investor, QSBS, and Shelter Blueprint

Matter: {plan.get('matter', '')}
Source: {plan.get('source', '')}
Manifest SHA-256: {plan.get('manifest_sha256', '')}

## Lanes

{bullets(plan.get('lanes', []))}

## Kickoff Commands

```bash
{chr(10).join(plan.get('kickoff_commands', []))}
```

{chr(10).join(phase_blocks)}

## Trust Taxonomy

- status: {plan.get('trust_taxonomy', {}).get('status')}
- trust types: {plan.get('trust_taxonomy', {}).get('trust_type_count')} / {plan.get('trust_taxonomy', {}).get('required_type_count')}

## Direct Ownership Carve-Outs

{bullets(plan.get('trust_taxonomy', {}).get('direct_ownership_carveouts', []))}

## Docket Items

{bullets(plan.get('docket_items', []))}

## Adversarial Reviewers

{bullets(plan.get('adversarial_reviewers', []))}

## Hard No-Go Controls

{bullets(plan.get('hard_no_go', []))}

## Authority Boundary

{plan.get('authority', '')}
"""


def tax_engine_blueprint(data: dict[str, Any], matter: str) -> dict[str, Any]:
    tax = lane_or_fail(data, "tax-system")
    founder = lane_or_fail(data, "founder-unicorn")
    uhnw = lane_or_fail(data, "uhnw-family-office")
    tax_engine = _items(tax, "tax_engine_required")
    tax_credit = _items(tax, "tax_credit_required")
    source_ingest = _items(tax, "source_ingest_required")
    creative = _items(tax, "creative_planning_required")
    estate_topology = _items(uhnw, "entity_topology_required")
    required_packet = list(data.get("required_packet", [])) + _items(tax, "required_lane_packet")
    failures: list[dict[str, str]] = []
    required_terms = (
        "GL trial-balance tie-out, book-to-tax M-1/M-3 bridge, return-line map, and control manifest",
        "forms and filing package: Form 3800, 6765, 3468, 8835, 8911, 8933, 8974, 8994/8995 where relevant, Form 8275/8275-R disclosure, state credit forms, and e-file/transmitter/MeF handoff owner",
        "return-position authority level, business-purpose/economic-substance memo, Form 8275/8275-R disclosure, and penalty-defense analysis",
        "SALT nexus, apportionment, sourcing, throwback, PTET, franchise/margin, sales/use tax, and state-credit matrix",
        "international information-return, FBAR/FATCA, Form 8938, 5471, 5472, 8865, 8858, GILTI, Subpart F, FDII, BEAT, 962, withholding, and treaty screen",
        "return/payment/e-file/transmitter/MeF/IRIS/SSA BSO handoff and no-live-filing authority check",
    )
    proof_text = "\n".join(tax_engine + tax_credit + source_ingest + required_packet)
    for term in required_terms:
        if term not in proof_text:
            failures.append({"id": "tax_engine_blueprint_term_missing", "detail": f"missing tax-engine blueprint term: {term}"})
    return {
        "status": "fail" if failures else "pass",
        "matter": matter,
        "source": str(MANIFEST.relative_to(ROOT)),
        "manifest_version": data.get("version"),
        "manifest_sha256": manifest_sha256(),
        "lanes": ["tax-system", "founder-unicorn", "uhnw-family-office"],
        "lead_seats": sorted(set(tax.get("lead_seats", []) + founder.get("lead_seats", []) + uhnw.get("lead_seats", []))),
        "sequence": [
            {
                "phase": "1. Intake, source evidence, current law, and current figures",
                "owner": "glaw-tax-legal-intake + glaw-legal-research",
                "outputs": [
                    "taxpayer profile, entity chart, source-file index, document hashes, missing-information list, and jurisdiction pack",
                    "current-law/current-figures freshness ledger and primary-law citation corpus before tax positions are drafted",
                    "local TAX CREDIT, LLC, SEC, QSBS, trust, credit, offering, and investor sources routed to owning seats with dated evidence rows",
                ],
                "required": source_ingest,
                "gate": "no tax position, credit claim, investor tax statement, or controversy recommendation without source-backed intake and authority freshness",
            },
            {
                "phase": "2. Entity classification, elections, basis, QSBS, and ownership",
                "owner": "glaw-tax-strategy + glaw-corporate-counsel + /glaw-entity-architect",
                "outputs": [
                    "C-corp, S-corp, partnership, LLC, disregarded-entity, and trust tax classification map",
                    "election calendar, section 1202/QSBS, section 1045, section 351, section 704, section 1368 AAA, basis, and capital-account workplan",
                    "founder, investor, pass-through, trust, and direct-ownership carve-out routing where tax rules make that preferable",
                ],
                "required": [
                    "entity classification, tax election, basis, AAA, capital account, section 704, section 1368, and section 1202/QSBS screen",
                    *[item for item in tax_engine if any(token in item for token in ("entity classification", "basis", "704", "1368", "1202"))],
                    *_items(founder, "qsbs_required")[:6],
                ],
            },
            {
                "phase": "3. Accounting-to-tax bridge",
                "owner": "/glaw-accounting + /glaw-controller + /glaw-tax-provision + /glaw-audit",
                "outputs": [
                    "GL trial-balance tie-out, book-to-tax M-1/M-3 bridge, return-line map, and control manifest",
                    "deferred-tax roll-forward, ASC 740, ETR, uncertain-tax-position register, and auditor/PBC bridge where relevant",
                    "reconciliation workpapers that let the preparer, auditor, IRS examiner, and CFO trace numbers back to the books",
                ],
                "required": [item for item in tax_engine if any(token in item for token in ("GL trial-balance", "tax provision", "ASC 740", "return-line"))],
            },
            {
                "phase": "4. Credits, incentives, substantiation, transferability, and recapture",
                "owner": "/glaw-credit-strategy + glaw-tax-strategy + /glaw-fixed-assets + /glaw-tax-provision",
                "outputs": [
                    "credit inventory across R&D, payroll, energy/IRA, LIHTC, NMTC, WOTC, historic, disaster, foreign, AMT, state/local, and industry incentives",
                    "substantiation file with contracts, invoices, payroll, time records, GL accounts, fixed-asset register, engineering records, certifications, permits, and hashes",
                    "Form 3800/6765/3468/8974/8275 package, section 6417 direct pay, section 6418 transferability, recapture monitoring, investor reporting, and no-guarantee disclosure",
                ],
                "required": tax_credit,
            },
            {
                "phase": "5. SALT, international, information returns, and withholding",
                "owner": "glaw-tax-strategy + /glaw-international-tax + /glaw-sales-tax",
                "outputs": [
                    "state nexus, apportionment, sourcing, throwback, PTET, franchise/margin, sales/use tax, and state-credit matrix",
                    "international information-return, FBAR/FATCA, Forms 8938/5471/5472/8865/8858, GILTI, Subpart F, FDII, BEAT, section 962, withholding, and treaty screen",
                    "investor, foreign, tax-exempt, pass-through, and trust reporting obligations separated from entity-level return mechanics",
                ],
                "required": [item for item in tax_engine if any(token in item for token in ("SALT", "international", "FBAR", "withholding"))],
            },
            {
                "phase": "6. Compliance, controversy, filing handoff, and no-live-filing authority",
                "owner": "glaw-tax-compliance + /glaw-irs-audit + /glaw-tax-court",
                "outputs": [
