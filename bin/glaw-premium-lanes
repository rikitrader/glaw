        "required_packet": required_packet,
        "docket_items": sorted(set(tax.get("docket_items", []) + founder.get("docket_items", []) + uhnw.get("docket_items", []))),
        "adversarial_reviewers": sorted(set(tax.get("adversarial_reviewers", []) + [
