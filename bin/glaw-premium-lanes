                    "public, public-ready, PE-backed, multinational, regulated, or enterprise-scale trigger classification",
                    "conflicts, engagement, UPL, source evidence, current figures, and jurisdiction pack before board, investor, auditor, or regulator use",
                    "board authority, delegation, subsidiaries, signatory, approval, beneficial-ownership, foreign-qualification, annual-report, and franchise-tax intake map",
                ],
                "required": [
                    "board authority, delegation, subsidiaries, signatory, approval, beneficial ownership, foreign-qualification, annual-report, and franchise-tax intake map",
                    *[item for item in enterprise_required if any(token in item for token in ("board authority", "subsidiary", "annual report", "foreign qualification", "beneficial ownership"))],
                ],
                "gate": "no enterprise recommendation until conflicts, engagement, current source evidence, and jurisdiction routing are complete",
            },
            {
