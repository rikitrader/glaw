            "bin/glaw-premium-lanes render-packet --lane tax-system --owner \"named tax lead\" --source \"SRC-0001 basis\"",
            "bin/glaw-premium-lanes check-packet --lane tax-system",
            "bin/glaw-premium-lanes docket --lane tax-system",
            "bin/glaw-final-packet build --profile auto",
        ],
        "failures": failures,
        "authority": "deterministic tax-engine operator blueprint only; it does not give legal, tax, accounting, investment, fiduciary, or securities advice and does not file, sign, transmit, pay, shelter assets, or authorize return positions without licensed professional and human approval",
    }


def tax_engine_blueprint_markdown(plan: dict[str, Any]) -> str:
    def bullets(items: list[Any]) -> str:
        return "\n".join(f"- {item}" for item in items) or "- none"

    phase_blocks = []
    for phase in plan.get("sequence", []):
        outputs = bullets(phase.get("outputs", []))
        required = bullets(phase.get("required", [])[:8])
        phase_blocks.append(
            f"## {phase.get('phase')}\n\n"
            f"Owner: {phase.get('owner')}\n\n"
            f"Gate: {phase.get('gate', 'source-backed owner/reviewer/docket proof required')}\n\n"
            f"Outputs:\n{outputs}\n\n"
            f"Required controls:\n{required}"
        )
    return f"""# Tax System, Credits, Compliance, And Controversy Blueprint

Matter: {plan.get('matter', '')}
Source: {plan.get('source', '')}
Manifest SHA-256: {plan.get('manifest_sha256', '')}

## Lanes

{bullets(plan.get('lanes', []))}

## Kickoff Commands

```bash
{chr(10).join(plan.get('kickoff_commands', []))}
```

{chr(10).join(phase_blocks)}

## Tax Engine Required

{bullets(plan.get('tax_engine_required', []))}

## Tax Credit Required

{bullets(plan.get('tax_credit_required', []))}

## Source Ingest Required

{bullets(plan.get('source_ingest_required', []))}

## Creative Planning Benchmark Required

{bullets(plan.get('creative_planning_required', []))}

## Docket Items

{bullets(plan.get('docket_items', []))}

## Adversarial Reviewers

{bullets(plan.get('adversarial_reviewers', []))}

## Hard No-Go Controls

{bullets(plan.get('hard_no_go', []))}

## Authority Boundary

{plan.get('authority', '')}
"""


def enterprise_blueprint(data: dict[str, Any], matter: str) -> dict[str, Any]:
    enterprise = lane_or_fail(data, "fortune500-enterprise")
    tax = lane_or_fail(data, "tax-system")
    enterprise_required = _items(enterprise, "enterprise_required")
    creative = _items(enterprise, "creative_planning_required")
    required_packet = list(data.get("required_packet", [])) + _items(enterprise, "required_lane_packet")
    failures: list[dict[str, str]] = []
    required_terms = (
        "board authority, delegation, subsidiaries, signatory, and approval matrix",
        "public-company reporting profile: filer status, 10-K, 10-Q, 8-K, S-1, proxy, Form 4/Section 16, Reg S-K, Reg S-X, and Inline XBRL screen",
        "SOX 302/906 certification, SOX 404 ICFR, disclosure controls and procedures, control-owner evidence, and deficiency/material-weakness remediation",
        "audit committee, PBC list, auditor independence, PCAOB inspection/challenge response, management representation, and audit-adjustment log",
        "ASC 740 current/deferred tax, ETR, UTP register, valuation allowance, tax provision close calendar, and auditor tie-out",
        "enterprise regulatory map: SEC, DOJ, FTC, CFPB, FinCEN/BSA/AML, OFAC, state AG, licensing, privacy, employment, and industry regulator exposure",
        "board/investor disclosure packet, investor-relations controls, analyst guidance, earnings release, and selective-disclosure/Reg FD review",
    )
    proof_text = "\n".join(enterprise_required + creative + required_packet)
    for term in required_terms:
        if term not in proof_text:
            failures.append({"id": "enterprise_blueprint_term_missing", "detail": f"missing enterprise blueprint term: {term}"})
    return {
        "status": "fail" if failures else "pass",
        "matter": matter,
        "source": str(MANIFEST.relative_to(ROOT)),
        "manifest_version": data.get("version"),
        "manifest_sha256": manifest_sha256(),
        "lanes": ["fortune500-enterprise", "tax-system"],
        "lead_seats": sorted(set(enterprise.get("lead_seats", []) + tax.get("lead_seats", []))),
        "sequence": [
