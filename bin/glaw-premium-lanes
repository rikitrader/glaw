                ],
                "required": [item for item in enterprise_required if any(token in item for token in ("board authority", "subsidiary", "M&A/capital markets", "recurring docket"))],
            },
            {
                "phase": "3. SEC disclosure, capital markets, investor relations, and Reg FD",
                "owner": "/glaw-sec-reporting + /glaw-sec-disclosure + /glaw-disclosure-risk-analyzer",
                "outputs": [
                    "filer-status profile and 10-K/10-Q/8-K/S-1/proxy/Form 4/Section 16 issue list",
                    "Reg S-K, Reg S-X, MD&A, risk-factor, forward-looking statement, non-GAAP, KPI, segment, related-party, cyber, climate, litigation, and Inline XBRL control calendar",
                    "earnings-release, analyst-guidance, investor-relations, selective-disclosure/Reg FD, and board/investor communications control packet",
