#!/usr/bin/env python3
"""Run the explicit red/blue legal cross-review protocol."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
from legal_governor import cross_review  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(prog="glaw-cross-review")
    sub = parser.add_subparsers(dest="command", required=True)
    for command in ("start", "check"):
        p = sub.add_parser(command)
        p.add_argument("--run-dir", required=True)
    p = sub.add_parser("record")
    p.add_argument("--run-dir", required=True)
    p.add_argument("--input", required=True, help="JSON object for the next protocol phase")
    args = parser.parse_args()
    run_dir = Path(args.run_dir).expanduser().resolve()
    try:
        if args.command == "start":
            result = cross_review.start(run_dir)
        elif args.command == "record":
            result = cross_review.record(run_dir, json.loads(Path(args.input).read_text(encoding="utf-8")))
        else:
            result = cross_review.check(run_dir)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(json.dumps({"status": "BLOCK", "error": str(exc)}, indent=2))
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if result.get("status") in {"PASS", "REVIEW_REQUIRED"} else 1


if __name__ == "__main__":
    raise SystemExit(main())
