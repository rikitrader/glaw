{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaw.local/schemas/transaction-comps.schema.json",
  "title": "GLAW Precedent Transaction Comps",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_id", "currency", "transactions"],
  "properties": {
    "analysis_id": {"type": "string", "pattern": "^TC-[0-9]{4,}$"},
    "currency": {"type": "string", "minLength": 3, "maxLength": 3},
    "transactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transaction_id", "target", "enterprise_value", "ltm_revenue", "ltm_ebitda"],
        "properties": {
          "transaction_id": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "announcement_date": {"type": "string"},
          "enterprise_value": {"type": "number", "exclusiveMinimum": 0},
          "equity_value": {"type": "number", "exclusiveMinimum": 0},
          "ltm_revenue": {"type": "number", "exclusiveMinimum": 0},
          "ltm_ebitda": {"type": "number", "exclusiveMinimum": 0},
          "ltm_ebit": {"type": "number", "exclusiveMinimum": 0},
          "control_premium_pct": {"type": "number", "minimum": -100},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
