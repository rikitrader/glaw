{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaw.local/schemas/glaw-registry-event.schema.json",
  "title": "GLAW Registry Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "occurred_at", "actor", "prev_hash", "payload", "event_hash"],
  "properties": {
    "schema_version": {"const": "glaw-registry/v1"},
    "event_id": {"type": "string", "pattern": "^EVT-[0-9]{6}$"},
    "event_type": {"enum": ["registry_initialized", "artifact_registered", "artifact_approved"]},
    "occurred_at": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 2},
    "prev_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload": {"type": "object"}
  }
}
