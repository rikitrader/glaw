{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glaw.local/schemas/prophet-actuary-pipeline.schema.json",
  "title": "PROPHET-ACTUARY Production Pipeline Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "valuation_date", "model_version", "sources", "policies", "assets"],
  "properties": {
    "schema_version": {"type":"string", "const":"prophet-pipeline/v1"},
    "run_id": {"type":"string", "pattern":"^RUN-[0-9]{4,}$"},
    "valuation_date": {"type":"string", "minLength":1},
    "model_version": {"type":"string", "minLength":1},
    "provider": {"type":"string", "enum":["local","external-prophet"]},
    "periods": {"type":"integer", "minimum":1, "maximum":120},
    "sources": {"type":"array", "minItems":1, "items":{"type":"object", "required":["source_id","version","effective_date"], "properties":{"source_id":{"type":"string"},"version":{"type":"string"},"effective_date":{"type":"string"},"sha256":{"type":"string"}}}},
    "policies": {"type":"array", "minItems":1, "items":{"type":"object", "required":["policy_id","premium","benefit"], "properties":{"policy_id":{"type":"string"},"premium":{"type":"number","minimum":0},"benefit":{"type":"number","minimum":0},"mortality":{"type":"number","minimum":0,"maximum":1},"morbidity":{"type":"number","minimum":0,"maximum":1},"lapse":{"type":"number","minimum":0,"maximum":1},"expense":{"type":"number","minimum":0},"interest_rate":{"type":"number","minimum":-1},"claim_rate":{"type":"number","minimum":0,"maximum":1}}}},
    "assets": {"type":"array", "items":{"type":"object", "required":["asset_id","balance","yield"], "properties":{"asset_id":{"type":"string"},"balance":{"type":"number","minimum":0},"yield":{"type":"number","minimum":-1},"duration":{"type":"number","minimum":0}}}},
    "reinsurance": {"type":"object", "properties":{"quota_share":{"type":"number","minimum":0,"maximum":1},"attachment":{"type":"number","minimum":0},"limit":{"type":"number","minimum":0}}},
    "scenarios": {"type":"object"}
  }
}
